{
  "name": "lr-place-furnace-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "set ASTRO_TELEMETRY_DISABLED=1&& astro build && node scripts/prepare-sites-static.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "qr": "node scripts/generate-qr.mjs",
    "test:hero": "node scripts/verify-hero.mjs all",
    "test:social-qr": "node scripts/verify-social-qr.mjs",
    "test:quiz": "node scripts/verify-quiz.mjs all",
    "test:installation-route": "node scripts/verify-installation-route.mjs all",
    "test:equipment-lineup": "node scripts/verify-equipment-lineup.mjs all",
    "test:section-removal": "node scripts/verify-section-removal.mjs all",
    "test:compatibility-system": "node scripts/verify-compatibility-system.mjs all",
    "test:case-slider": "node scripts/verify-case-slider.mjs all",
    "test:document-card": "node scripts/verify-document-card.mjs",
    "test:faq": "node scripts/verify-faq.mjs",
    "test:contact-form": "node scripts/verify-contact-form.mjs"
  },
  "dependencies": {
    "astro": "^7.0.7",
    "glightbox": "^3.3.1",
    "sass": "^1.89.0",
    "swiper": "^12.2.0"
