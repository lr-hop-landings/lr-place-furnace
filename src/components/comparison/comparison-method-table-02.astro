---
interface ComparisonRow {
  criterion: string;
  usual: string;
  professional: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  rows?: ComparisonRow[];
}

const {
  eyebrow = "Сравнение",
  headline = "Чем профессиональная обработка отличается от обычной уборки",
  rows = [
    { criterion: "Источник запаха", usual: "Маскируется бытовой химией", professional: "Находится и удаляется до финишной обработки" },
    { criterion: "Материалы", usual: "Обрабатываются только видимые поверхности", professional: "Проверяются пористые материалы, швы и труднодоступные зоны" },
    { criterion: "Безопасность", usual: "Зависит от опыта исполнителя", professional: "Есть протокол, защита и контроль состава работ" },
    { criterion: "Документы", usual: "Обычно отсутствуют", professional: "Можно получить договор, чек и акт" },
  ],
} = Astro.props;
---

<section class="method-comparison">
  <div class="method-comparison__inner">
    <header>
      {eyebrow && <p>{eyebrow}</p>}
      <h2>{headline}</h2>
    </header>
    <div class="method-comparison__table">
      <div class="method-comparison__head">
        <span>Критерий</span>
        <span>Металлическая печь</span>
        <span>Кирпичная печь</span>
      </div>
      {rows.map((row) => (
        <article>
          <strong>{row.criterion}</strong>
          <span>{row.usual}</span>
          <span>{row.professional}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .method-comparison {
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    background: var(--color-surface, #ffffff);
    color: var(--color-text, #152028);
  }

  .method-comparison__inner {
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
  }

  .method-comparison header {
    max-width: 900px;
    margin-bottom: 44px;
  }

  .method-comparison p,
  .method-comparison span,
  .method-comparison strong {
    font-family: var(--font-body, sans-serif);
  }

  .method-comparison header p {
    margin: 0 0 16px;
    font-size: var(--text-xs, 12px);
    font-weight: 800;
    text-transform: uppercase;
  }

  .method-comparison h2 {
    margin: 0;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(36px, 6vw, 78px);
    line-height: 1;
  }

  .method-comparison__table {
    border-top: 1px solid #000000;
    border-left: 1px solid #000000;
  }

  .method-comparison__head,
  .method-comparison article {
    display: grid;
    grid-template-columns: 0.8fr 1fr 1fr;
  }

  .method-comparison__head span,
  .method-comparison article > * {
    padding: 20px;
    border-right: 1px solid #000000;
    border-bottom: 1px solid #000000;
    line-height: 1.55;
  }

  .method-comparison__head span {
    background: #000000;
    color: #ffffff;
    font-weight: 800;
    text-transform: uppercase;
  }

  .method-comparison strong {
    font-weight: 900;
  }

  @media (max-width: 760px) {
    .method-comparison__head {
      display: none;
    }

    .method-comparison article {
      grid-template-columns: 1fr;
    }

    .method-comparison article span::before {
      display: block;
      margin-bottom: 8px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .method-comparison article span:nth-child(2)::before {
      content: "Обычная уборка";
    }

    .method-comparison article span:nth-child(3)::before {
      content: "Профессионально";
    }
  }
</style>
