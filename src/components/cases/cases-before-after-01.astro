---
interface StageMedia {
  src?: string;
  alt?: string;
  caption: string;
}

interface CaseItem {
  title: string;
  objectType?: string;
  task: string;
  works: string[];
  result: string;
  status?: string;
  before: StageMedia;
  after: StageMedia;
}

interface Props {
  eyebrow?: string;
  headline: string;
  accent?: string;
  subline?: string;
  items: CaseItem[];
}

const {
  eyebrow = "Сравнение результата",
  headline,
  accent,
  subline,
  items,
} = Astro.props;
---

<section class="before-after" aria-labelledby="before-after-title">
  <div class="before-after__inner">
    <header class="before-after__header">
      <p>{eyebrow}</p>
      <h2 id="before-after-title">
        {headline}
        {accent && <span>{accent}</span>}
      </h2>
      {subline && <div>{subline}</div>}
    </header>

    <div class="before-after__list">
      {items.map((item, itemIndex) => (
        <article class="before-after__case">
          <div class="before-after__media-grid">
            {(["before", "after"] as const).map((stage) => {
              const media = item[stage];
              const stageLabel = stage === "before" ? "До" : "После";

              return (
                <figure class:list={["before-after__media", `before-after__media--${stage}`]}>
                  <span class="before-after__stage">{stageLabel}</span>
                  {media.src ? (
                    <a
                      class="before-after__image glightbox"
                      href={media.src}
                      data-gallery={`repair-case-${itemIndex + 1}`}
                      data-title={`${item.title} — ${stageLabel.toLowerCase()}`}
                    >
                      <img
                        src={media.src}
                        alt={media.alt ?? `${item.title}: ${stageLabel.toLowerCase()}`}
                        width="1200"
                        height="900"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  ) : (
                    <div class="before-after__placeholder" role="img" aria-label={`${stageLabel}: подтверждённая фотография будет добавлена`}>
                      <svg viewBox="0 0 120 120" aria-hidden="true">
                        <path d="M40 25h40v70H40zM46 17h28v8M48 43h24v29H48zM44 95l-5 9M76 95l5 9" />
                        <path d="M52 50h16M64 78h4" />
                      </svg>
                      <strong>Фото {stageLabel.toLowerCase()}</strong>
                      <span>Добавим после подтверждения материала</span>
                    </div>
                  )}
                  <figcaption>{media.caption}</figcaption>
                </figure>
              );
            })}
          </div>

          <div class="before-after__body">
            <div class="before-after__title-row">
              <div>
                {item.objectType && <p>{item.objectType}</p>}
                <h3>{item.title}</h3>
              </div>
              <span aria-hidden="true">{String(itemIndex + 1).padStart(2, "0")}</span>
            </div>

            <dl>
              <div>
                <dt>Задача</dt>
                <dd>{item.task}</dd>
              </div>
              <div>
                <dt>Что покажем</dt>
                <dd>
                  <ul>{item.works.map((work) => <li>{work}</li>)}</ul>
                </dd>
              </div>
              <div>
                <dt>Результат</dt>
                <dd>{item.result}</dd>
              </div>
            </dl>

            {item.status && <p class="before-after__status">{item.status}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .before-after {
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    color: var(--color-white, #fff);
    background:
      radial-gradient(circle at 88% 12%, rgb(231 101 37 / 14%), transparent 28rem),
      var(--color-primary-dark, #0b1f33);
  }

  .before-after__inner {
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
  }

  .before-after__header {
    max-width: 840px;
  }

  .before-after__header > p {
    margin: 0 0 14px;
    color: #ffbb91;
    font-size: var(--text-xs, 12px);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .before-after__header h2 {
    margin: 0;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .before-after__header h2 span {
    display: block;
    color: #ff9a60;
  }

  .before-after__header > div {
    max-width: 720px;
    margin-top: 20px;
    color: rgb(255 255 255 / 72%);
    font-size: var(--text-lg, 18px);
    line-height: 1.65;
  }

  .before-after__list {
    display: grid;
    gap: 32px;
    margin-top: 48px;
  }

  .before-after__case {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, .82fr);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: var(--radius-card, 24px);
    background: rgb(255 255 255 / 5%);
  }

  .before-after__media-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    background: rgb(255 255 255 / 14%);
  }

  .before-after__media {
    position: relative;
    min-width: 0;
    margin: 0;
    background: #132b3f;
  }

  .before-after__stage {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 16px;
    padding: 8px 12px;
    border-radius: 999px;
    color: #fff;
    background: rgb(11 31 51 / 86%);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .before-after__media--after .before-after__stage {
    background: var(--color-accent, #e76525);
  }

  .before-after__image {
    display: block;
    height: 100%;
    min-height: 390px;
  }

  .before-after__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .before-after__placeholder {
    display: grid;
    min-height: 390px;
    place-content: center;
    justify-items: center;
    padding: 40px 24px;
    text-align: center;
    background:
      linear-gradient(rgb(255 255 255 / 6%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 6%) 1px, transparent 1px),
      #173147;
    background-size: 28px 28px;
  }

  .before-after__media--before .before-after__placeholder {
    filter: saturate(.55);
  }

  .before-after__placeholder svg {
    width: 92px;
    color: rgb(255 255 255 / 62%);
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .before-after__placeholder strong {
    margin-top: 18px;
    font-family: var(--font-heading, sans-serif);
    font-size: 20px;
  }

  .before-after__placeholder span {
    max-width: 220px;
    margin-top: 7px;
    color: rgb(255 255 255 / 58%);
    font-size: 13px;
    line-height: 1.45;
  }

  .before-after__media figcaption {
    min-height: 66px;
    padding: 16px 18px;
    color: rgb(255 255 255 / 70%);
    font-size: 13px;
    line-height: 1.45;
  }

  .before-after__body {
    padding: clamp(28px, 4vw, 44px);
  }

  .before-after__title-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  .before-after__title-row p {
    margin: 0 0 8px;
    color: #ffbb91;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .before-after__title-row h3 {
    margin: 0;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.12;
  }

  .before-after__title-row > span {
    color: rgb(255 255 255 / 18%);
    font-family: var(--font-heading, sans-serif);
    font-size: 48px;
    font-weight: 800;
    line-height: .9;
  }

  .before-after dl {
    display: grid;
    gap: 0;
    margin: 28px 0 0;
  }

  .before-after dl > div {
    padding: 18px 0;
    border-top: 1px solid rgb(255 255 255 / 14%);
  }

  .before-after dt {
    color: #ffbb91;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .before-after dd {
    margin: 8px 0 0;
    color: rgb(255 255 255 / 76%);
    line-height: 1.55;
  }

  .before-after dd ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 18px;
  }

  .before-after__status {
    margin: 22px 0 0;
    padding: 12px 14px;
    border-left: 3px solid var(--color-accent, #e76525);
    color: rgb(255 255 255 / 68%);
    background: rgb(255 255 255 / 5%);
    font-size: 12px;
    line-height: 1.5;
  }

  .before-after__image:focus-visible {
    outline: 3px solid var(--color-accent, #e76525);
    outline-offset: -5px;
  }

  @media (max-width: 960px) {
    .before-after__case {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .before-after {
      padding: 72px 16px;
    }

    .before-after__media-grid {
      grid-template-columns: 1fr;
    }

    .before-after__image,
    .before-after__placeholder {
      min-height: 300px;
    }

    .before-after__body {
      padding: 26px 22px 30px;
    }

    .before-after__title-row > span {
      font-size: 38px;
    }
  }
</style>
