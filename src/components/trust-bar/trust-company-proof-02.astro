---
interface ProofItem {
  title: string;
  text: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  description?: string;
  proofs?: ProofItem[];
  ctaLabel?: string;
  ctaHref?: string;
  phone?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  eyebrow = "Нам доверяют главное",
  headline = "Доверяйте проверенной компании",
  description = "Секция для чувствительных услуг: объясняет юридическую ответственность, штатную команду и официальные документы без давления на клиента.",
  proofs = [
    { title: "Ответственность", text: "Компания отвечает за качество обработки и фиксирует перечень работ." },
    { title: "Штатная команда", text: "На объект приезжают обученные специалисты, а не случайные подрядчики." },
    { title: "Документы", text: "Договор, чек и закрывающие материалы подходят для отчетности." },
  ],
  ctaLabel = "Связаться",
  ctaHref = "#contacts",
  phone = "8 (812) 344-44-44",
  imageSrc,
  imageAlt = "Команда сервиса",
} = Astro.props;
---

<section class="company-proof">
  <div class="company-proof__inner">
    <div class="company-proof__content">
      {eyebrow && <p>{eyebrow}</p>}
      <h2>{headline}</h2>
      <span>{description}</span>
      <ul>
        {proofs.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <small>{item.text}</small>
          </li>
        ))}
      </ul>
      <div class="company-proof__actions">
        <a class="company-proof__button" href={ctaHref}>{ctaLabel}</a>
        {phone && <a class="company-proof__phone" href={`tel:${phone.replaceAll(/[^\d+]/g, "")}`}>{phone}</a>}
      </div>
    </div>
    <div class="company-proof__media">
      {imageSrc
        ? <img src={imageSrc} alt={imageAlt} loading="lazy" />
        : <div class="company-proof__fallback" role="img" aria-label="Место для образцов документов компании">
            <span>Смета</span><span>Договор</span><span>Акт</span>
            <small>Образцы документов будут добавлены после предоставления заказчиком</small>
          </div>}
    </div>
  </div>
</section>

<style>
  .company-proof {
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    background: var(--color-primary-dark, #0b1f33);
    color: #ffffff;
  }

  .company-proof__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.9fr);
    gap: clamp(32px, 6vw, 88px);
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
    align-items: center;
  }

  .company-proof p {
    margin: 0 0 16px;
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-xs, 12px);
    font-weight: 800;
    text-transform: uppercase;
  }

  .company-proof h2 {
    margin: 0;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(38px, 6vw, 78px);
    line-height: 1;
    letter-spacing: 0;
  }

  .company-proof__content > span {
    display: block;
    max-width: 660px;
    margin-top: 24px;
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-lg, 18px);
    line-height: 1.65;
  }

  .company-proof ul {
    display: grid;
    gap: 0;
    margin: 42px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid #ffffff;
  }

  .company-proof li {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid #ffffff;
    font-family: var(--font-body, sans-serif);
  }

  .company-proof small {
    font-size: var(--text-base, 16px);
    line-height: 1.58;
  }

  .company-proof__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    margin-top: 40px;
  }

  .company-proof__button,
  .company-proof__phone {
    color: inherit;
    font-family: var(--font-body, sans-serif);
    font-weight: 800;
    text-decoration: none;
  }

  .company-proof__button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0 28px;
    border: 1px solid #ffffff;
    background: #ffffff;
    color: #000000;
  }

  .company-proof__phone {
    border-bottom: 1px solid currentColor;
  }

  .company-proof__media {
    display: grid;
    aspect-ratio: 4 / 3;
    place-items: center;
    border: 1px solid #ffffff;
    background: #d8d8d8;
    overflow: hidden;
  }

  .company-proof__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  .company-proof__fallback {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    width: min(86%, 430px);
    color: #111827;
  }

  .company-proof__fallback span {
    display: grid;
    aspect-ratio: 3 / 4;
    place-items: end start;
    padding: 12px;
    border: 2px solid currentColor;
    background: repeating-linear-gradient(to bottom, transparent 0 18px, rgb(17 24 39 / 18%) 19px 20px);
    font-family: var(--font-body, sans-serif);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .company-proof__fallback small {
    grid-column: 1 / -1;
    font-family: var(--font-body, sans-serif);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.45;
    text-align: center;
  }

  @media (max-width: 860px) {
    .company-proof__inner,
    .company-proof li {
      grid-template-columns: 1fr;
    }
  }
</style>
