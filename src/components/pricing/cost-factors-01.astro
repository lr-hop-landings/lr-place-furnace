---
interface CostItem {
  title: string;
  text: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  subline?: string;
  items: CostItem[];
  note?: string;
}

const { eyebrow = "Состав сметы", headline, subline, items, note } = Astro.props;
---

<section class="cost-factors" aria-labelledby="cost-factors-title">
  <div class="cost-factors__inner">
    <header class="cost-factors__header">
      <p>{eyebrow}</p>
      <h2 id="cost-factors-title">{headline}</h2>
      {subline && <div>{subline}</div>}
    </header>

    <ol class="cost-factors__items">
      {items.map((item, index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ol>

    {note && <p class="cost-factors__note">{note}</p>}
  </div>
</section>

<style>
  .cost-factors {
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    background: var(--color-background, #f6f4ef);
  }

  .cost-factors__inner {
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
  }

  .cost-factors__header {
    display: grid;
    grid-template-columns: minmax(260px, .8fr) minmax(0, 1.2fr);
    column-gap: clamp(40px, 7vw, 96px);
    align-items: end;
  }

  .cost-factors__header > p {
    grid-column: 1 / -1;
    margin: 0 0 14px;
    color: var(--color-accent, #e76525);
    font-size: var(--text-xs, 12px);
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .cost-factors h2 {
    margin: 0;
    color: var(--color-text, #152028);
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(38px, 4.7vw, 58px);
    line-height: 1.04;
    letter-spacing: -.035em;
  }

  .cost-factors__header > div {
    color: var(--color-text-muted, #60717d);
    font-size: var(--text-lg, 18px);
    line-height: 1.65;
  }

  .cost-factors__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 48px 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border, #d6dee3);
    list-style: none;
  }

  .cost-factors__items li {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 18px;
    padding: 28px 26px 28px 0;
    border-bottom: 1px solid var(--color-border, #d6dee3);
  }

  .cost-factors__items li:nth-child(odd) {
    padding-right: 40px;
    border-right: 1px solid var(--color-border, #d6dee3);
  }

  .cost-factors__items li:nth-child(even) {
    padding-left: 40px;
  }

  .cost-factors__items li > span {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 10px;
    color: #fff;
    background: var(--color-primary, #123a5a);
    font-size: 12px;
    font-weight: 800;
  }

  .cost-factors h3 {
    margin: 0;
    color: var(--color-text, #152028);
    font-family: var(--font-heading, sans-serif);
    font-size: 20px;
    line-height: 1.25;
  }

  .cost-factors__items p {
    margin: 8px 0 0;
    color: var(--color-text-muted, #60717d);
    line-height: 1.58;
  }

  .cost-factors__note {
    max-width: 760px;
    margin: 28px 0 0 auto;
    padding: 18px 20px;
    border-left: 4px solid var(--color-accent, #e76525);
    color: var(--color-text, #152028);
    background: #fff;
    font-weight: 650;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .cost-factors__header {
      grid-template-columns: 1fr;
    }

    .cost-factors__header > div {
      margin-top: 20px;
      font-size: 16px;
    }

    .cost-factors__items {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }

    .cost-factors__items li,
    .cost-factors__items li:nth-child(odd),
    .cost-factors__items li:nth-child(even) {
      padding: 24px 0;
      border-right: 0;
    }
  }

  @media (max-width: 520px) {
    .cost-factors {
      padding: 72px 16px;
    }

    .cost-factors__items li {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 14px;
    }

    .cost-factors__items li > span {
      width: 38px;
      height: 38px;
    }
  }
</style>
