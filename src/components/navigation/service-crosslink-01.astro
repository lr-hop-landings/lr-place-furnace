---
interface Props {
  eyebrow?: string;
  badge?: string;
  headline: string;
  text: string;
  href: string;
  linkLabel: string;
  subtext?: string;
  points?: string[];
  index?: string;
  bgImage?: string;
}

const {
  eyebrow = "Рядом по теме",
  badge,
  headline,
  text,
  href,
  linkLabel,
  subtext,
  points = [],
  index = "02",
  bgImage,
} = Astro.props;

const isRepair = index === "02" || href.includes("remont");
const activeBgImage =
  bgImage ??
  (isRepair
    ? "/images/cases/generated/repair-01-brick-portal.webp"
    : "/images/cases/generated/installation-01-steel-stove-wood-house.webp");
---

<aside class="service-crosslink" aria-labelledby={`service-crosslink-${index}`}>
  <div class="service-crosslink__inner">
    {/* Descriptive background image with gradient fade into transparency */}
    <div
      class="service-crosslink__visual-bg"
      aria-hidden="true"
      style={`--crosslink-bg: url('${activeBgImage}');`}
    >
      <div class="service-crosslink__visual-img"></div>
      <div class="service-crosslink__visual-fade"></div>
    </div>

    {/* Content column */}
    <div class="service-crosslink__content">
      <div class="service-crosslink__header-row">
        {badge && (
          <span class="service-crosslink__badge">
            <span class="service-crosslink__badge-dot" aria-hidden="true"></span>
            <span>{badge}</span>
          </span>
        )}
        <p class="service-crosslink__eyebrow">{eyebrow}</p>
      </div>

      <h2 id={`service-crosslink-${index}`}>{headline}</h2>
      <p class="service-crosslink__text">{text}</p>

      {points.length > 0 && (
        <ul class="service-crosslink__points">
          {points.map((point) => (
            <li class="service-crosslink__point">
              <svg class="service-crosslink__check" viewBox="0 0 16 16" aria-hidden="true">
                <path
                  d="M13.2 4.3a.9.9 0 0 1 0 1.3l-6 6a.9.9 0 0 1-1.3 0l-3-3a.9.9 0 0 1 1.3-1.3L6.5 9.6l5.4-5.3a.9.9 0 0 1 1.3 0z"
                  fill="currentColor"
                />
              </svg>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    {/* CTA action column */}
    <div class="service-crosslink__action">
      <a class="service-crosslink__link" href={href}>
        <span class="service-crosslink__link-label">{linkLabel}</span>
        <span class="service-crosslink__link-icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor">
            <path d="M4 10h12M11 5l5 5-5 5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
      {subtext && <p class="service-crosslink__subtext">{subtext}</p>}
    </div>
  </div>
</aside>

<style>
  .service-crosslink {
    padding: clamp(36px, 5.5vw, 68px) var(--space-4, 16px);
    background: var(--color-background, #f6f4ef);
  }

  .service-crosslink__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
    padding: clamp(32px, 4.5vw, 50px) clamp(28px, 4.5vw, 54px);
    border-radius: var(--radius-card, 24px);
    border: 1px solid rgb(18 58 90 / 16%);
    background:
      linear-gradient(135deg, #ffffff 0%, #fdfbf7 55%, #f6f0e6 100%);
    box-shadow:
      inset 0 1px 0 #ffffff,
      var(--shadow-hard, 8px 8px 0 #0b1f33);
    color: var(--color-text, #152028);
    overflow: hidden;
    transition: border-color 220ms ease;
  }

  .service-crosslink__inner:hover {
    border-color: rgb(18 58 90 / 28%);
  }

  /* Visual background container */
  .service-crosslink__visual-bg {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 58%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .service-crosslink__visual-img {
    position: absolute;
    inset: 0;
    background-image: var(--crosslink-bg);
    background-size: cover;
    background-position: center right;
    filter: saturate(1.08) contrast(1.04);
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.1) 15%, rgba(0, 0, 0, 0.6) 45%, rgba(0, 0, 0, 0.95) 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.1) 15%, rgba(0, 0, 0, 0.6) 45%, rgba(0, 0, 0, 0.95) 100%);
    transition: transform 420ms cubic-bezier(0.2, 0, 0.2, 1);
  }

  .service-crosslink__inner:hover .service-crosslink__visual-img {
    transform: scale(1.035);
  }

  .service-crosslink__visual-fade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, #ffffff 0%, rgba(255, 255, 255, 0.45) 30%, transparent 65%),
      radial-gradient(circle at 90% 25%, rgb(231 101 37 / 10%) 0%, transparent 55%);
    pointer-events: none;
  }

  /* Content area */
  .service-crosslink__content {
    position: relative;
    z-index: 1;
    max-width: 680px;
  }

  .service-crosslink__header-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-bottom: 12px;
  }

  .service-crosslink__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--color-accent-light, #ffefe5);
    border: 1px solid rgb(231 101 37 / 22%);
    color: var(--color-accent, #e76525);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .service-crosslink__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: crosslink-dot 2.4s ease-in-out infinite;
  }

  @keyframes crosslink-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.85); }
  }

  .service-crosslink__eyebrow {
    margin: 0;
    color: var(--color-primary, #123a5a);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .service-crosslink h2 {
    margin: 0;
    color: var(--color-primary-dark, #0b1f33);
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(23px, 2.7vw, 34px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .service-crosslink__text {
    max-width: 630px;
    margin: 12px 0 0;
    color: var(--color-text-muted, #556877);
    font-size: clamp(14.5px, 1.05vw, 16px);
    line-height: 1.55;
  }

  /* Points chips */
  .service-crosslink__points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .service-crosslink__point {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 90%);
    border: 1px solid rgb(18 58 90 / 14%);
    box-shadow: 0 1px 3px rgb(11 31 51 / 4%);
    color: var(--color-primary, #123a5a);
    font-size: 13px;
    font-weight: 650;
    line-height: 1.3;
    backdrop-filter: blur(4px);
  }

  .service-crosslink__check {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-accent, #e76525);
  }

  /* CTA action column */
  .service-crosslink__action {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    min-width: 240px;
  }

  .service-crosslink__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 12px 16px 12px 22px;
    border-radius: var(--radius-button, 14px);
    background: linear-gradient(180deg, #f07231 0%, #e76525 100%);
    color: #ffffff;
    font-family: var(--font-heading, sans-serif);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.25;
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 35%),
      0 4px 0 #b84916,
      0 8px 18px -4px rgb(231 101 37 / 35%);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }

  .service-crosslink__link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 20%);
    transition: transform 180ms cubic-bezier(0.34, 1.56, 0.64, 1), background-color 180ms ease;
  }

  .service-crosslink__link-icon svg {
    width: 16px;
    height: 16px;
  }

  .service-crosslink__link:hover {
    transform: translateY(-2px);
    background: linear-gradient(180deg, #f57d3e 0%, #eb6a2b 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 40%),
      0 6px 0 #b84916,
      0 12px 24px -4px rgb(231 101 37 / 45%);
  }

  .service-crosslink__link:hover .service-crosslink__link-icon {
    transform: translateX(3px);
    background: rgb(255 255 255 / 30%);
  }

  .service-crosslink__link:active {
    transform: translateY(2px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 20%),
      0 2px 0 #b84916,
      0 4px 8px -2px rgb(231 101 37 / 30%);
  }

  .service-crosslink__link:focus-visible {
    outline: 3px solid var(--color-primary, #123a5a);
    outline-offset: 4px;
  }

  .service-crosslink__subtext {
    width: fit-content;
    margin: 4px auto 0;
    padding: 3px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 88%);
    border: 1px solid rgb(18 58 90 / 12%);
    box-shadow: 0 1px 3px rgb(11 31 51 / 4%);
    font-size: 11.5px;
    font-weight: 650;
    color: var(--color-primary-dark, #0b1f33);
    text-align: center;
    line-height: 1.35;
    backdrop-filter: blur(4px);
  }

  /* Responsive layout */
  @media (max-width: 960px) {
    .service-crosslink__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .service-crosslink__visual-bg {
      width: 65%;
      opacity: 0.85;
    }

    .service-crosslink__action {
      width: fit-content;
      min-width: 260px;
    }
  }

  @media (max-width: 640px) {
    .service-crosslink {
      padding: 32px 14px 44px;
    }

    .service-crosslink__inner {
      gap: 20px;
      padding: 24px 18px 24px;
      border-radius: 20px;
      box-shadow:
        inset 0 1px 0 #ffffff,
        5px 5px 0 var(--color-primary-dark, #0b1f33);
    }

    .service-crosslink__visual-bg {
      width: 100%;
      height: 100%;
      opacity: 0.22;
    }

    .service-crosslink__visual-img {
      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.4) 0%, transparent 85%);
      -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.4) 0%, transparent 85%);
    }

    .service-crosslink h2 {
      font-size: 21px;
      line-height: 1.2;
    }

    .service-crosslink__text {
      margin-top: 10px;
      font-size: 14px;
    }

    .service-crosslink__points {
      margin-top: 14px;
      gap: 6px;
    }

    .service-crosslink__point {
      padding: 5px 10px;
      font-size: 12px;
    }

    .service-crosslink__action {
      width: 100%;
      min-width: 0;
      margin-top: 4px;
    }

    .service-crosslink__link {
      width: 100%;
      justify-content: center;
      gap: 12px;
      padding: 14px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-crosslink__link,
    .service-crosslink__link-icon,
    .service-crosslink__badge-dot,
    .service-crosslink__visual-img {
      transition: none;
      animation: none;
      transform: none !important;
    }
  }
</style>

