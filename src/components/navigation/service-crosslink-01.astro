---
interface Props {
  eyebrow?: string;
  headline: string;
  text: string;
  href: string;
  linkLabel: string;
  points?: string[];
  index?: string;
}

const {
  eyebrow = "Рядом по теме",
  headline,
  text,
  href,
  linkLabel,
  points = [],
  index = "02",
} = Astro.props;
---

<aside class="service-crosslink" aria-labelledby={`service-crosslink-${index}`}>
  <div class="service-crosslink__inner">
    <div class="service-crosslink__marker" aria-hidden="true">
      <strong>{index}</strong>
    </div>

    <div class="service-crosslink__content">
      <p class="service-crosslink__eyebrow">{eyebrow}</p>
      <h2 id={`service-crosslink-${index}`}>{headline}</h2>
      <p class="service-crosslink__text">{text}</p>

      {points.length > 0 && (
        <ul>
          {points.map((point) => <li>{point}</li>)}
        </ul>
      )}
    </div>

    <a class="service-crosslink__link" href={href}>
      <span>{linkLabel}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h13M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>
</aside>

<style>
  .service-crosslink {
    padding: clamp(32px, 5vw, 64px) var(--space-4, 16px);
    background: var(--color-background, #f6f4ef);
  }

  .service-crosslink__inner {
    position: relative;
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr) minmax(210px, auto);
    gap: clamp(26px, 4vw, 52px);
    align-items: center;
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
    padding: clamp(28px, 4vw, 48px);
    overflow: hidden;
    border: 1px solid rgb(18 58 90 / 24%);
    border-radius: var(--radius-card, 24px);
    color: var(--color-text, #152028);
    background:
      linear-gradient(105deg, rgb(255 255 255 / 96%) 0 67%, rgb(232 238 241 / 76%) 100%);
    box-shadow: 8px 8px 0 var(--color-primary-dark, #0b1f33);
  }

  .service-crosslink__inner::after {
    position: absolute;
    right: -72px;
    bottom: -110px;
    width: 260px;
    height: 260px;
    border: 34px solid rgb(231 101 37 / 8%);
    border-radius: 50%;
    pointer-events: none;
    content: "";
  }

  .service-crosslink__marker {
    display: grid;
    width: 104px;
    height: 104px;
    place-content: center;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 20px;
    color: #fff;
    background: var(--color-primary-dark, #0b1f33);
    text-align: center;
  }

  .service-crosslink__marker strong {
    color: #ff9a60;
    font-family: var(--font-heading, sans-serif);
    font-size: 38px;
    line-height: 1;
  }

  .service-crosslink__content {
    position: relative;
    z-index: 1;
    max-width: 660px;
  }

  .service-crosslink__eyebrow {
    margin: 0 0 10px;
    color: var(--color-accent, #e76525);
    font-size: var(--text-xs, 12px);
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .service-crosslink h2 {
    margin: 0;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.08;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  .service-crosslink__text {
    max-width: 650px;
    margin: 14px 0 0;
    color: var(--color-text-muted, #60717d);
    line-height: 1.58;
  }

  .service-crosslink ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .service-crosslink li {
    padding: 7px 10px;
    border: 1px solid var(--color-border, #d6dee3);
    border-radius: 999px;
    color: var(--color-primary, #123a5a);
    background: rgb(255 255 255 / 74%);
    font-size: 12px;
    font-weight: 750;
  }

  .service-crosslink__link {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 0 20px 0 22px;
    border-radius: var(--radius-button, 12px);
    color: #fff;
    background: var(--color-accent, #e76525);
    box-shadow: 0 5px 0 #b84916;
    font-weight: 800;
    line-height: 1.3;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .service-crosslink__link svg {
    width: 24px;
    height: 24px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms ease;
  }

  .service-crosslink__link:hover {
    transform: translateY(2px);
    background: #cf541f;
    box-shadow: 0 3px 0 #a33e11;
  }

  .service-crosslink__link:hover svg {
    transform: translateX(4px);
  }

  .service-crosslink__link:focus-visible {
    outline: 3px solid var(--color-primary, #123a5a);
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .service-crosslink__inner {
      grid-template-columns: 82px minmax(0, 1fr);
    }

    .service-crosslink__marker {
      width: 82px;
      height: 82px;
      border-radius: 16px;
    }

    .service-crosslink__marker strong {
      font-size: 31px;
    }

    .service-crosslink__link {
      grid-column: 2;
      width: fit-content;
      min-width: 250px;
    }
  }

  @media (max-width: 600px) {
    .service-crosslink {
      padding: 36px 16px 48px;
    }

    .service-crosslink__inner {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 24px;
      border-radius: 18px;
      box-shadow: 5px 5px 0 var(--color-primary-dark, #0b1f33);
    }

    .service-crosslink__marker {
      width: 64px;
      height: 64px;
      border-radius: 13px;
    }

    .service-crosslink__marker strong {
      font-size: 25px;
    }

    .service-crosslink__text {
      font-size: 15px;
    }

    .service-crosslink ul {
      display: grid;
      justify-items: start;
    }

    .service-crosslink__link {
      grid-column: auto;
      width: 100%;
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-crosslink__link,
    .service-crosslink__link svg {
      transition: none;
    }
  }
</style>
