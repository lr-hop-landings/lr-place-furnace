---
interface Item {
  name: string;
  text: string;
  price?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  headline: string;
  subline?: string;
  items: Item[];
  label?: string;
  variant?: "cards" | "equipment-lineup";
}

const {
  headline,
  subline,
  items,
  label = "Стоимость",
  variant = "cards",
} = Astro.props;
const isEquipmentLineup = variant === "equipment-lineup";
---

<section
  class:list={[
    "card-grid",
    { "card-grid--equipment-lineup": isEquipmentLineup },
  ]}
  data-card-grid-variant={variant}
  data-equipment-lineup={isEquipmentLineup ? "" : undefined}
>
  <div class="card-grid__inner">
    <header class="card-grid__header">
      {
        isEquipmentLineup && (
          <p class="card-grid__eyebrow">Готовые металлические печи</p>
        )
      }
      <h2>{headline}</h2>
      {subline && <p class="card-grid__subline">{subline}</p>}
    </header>

    {
      isEquipmentLineup ? (
        <div
          class="card-grid__lineup-slider swiper"
          data-swiper-options='{"slidesPerView":"auto","spaceBetween":16,"breakpoints":{"1024":{"slidesPerView":4,"spaceBetween":24}}}'
        >
          <div class="card-grid__lineup swiper-wrapper">
            {items.map((item, index) => (
              <article class="card-grid__lineup-item swiper-slide">
                <div class="card-grid__lineup-visual">
                  {item.image && (
                    <img
                      src={item.image}
                      alt={item.imageAlt ?? item.name}
                      width="960"
                      height="1200"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
                <div class="card-grid__lineup-body">
                  <span class="card-grid__lineup-number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3>{item.name}</h3>
                  <p>{item.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      ) : (
        <div
          class="card-grid__slider swiper"
          data-swiper-options='{"slidesPerView":1,"spaceBetween":20,"breakpoints":{"680":{"slidesPerView":2},"1040":{"slidesPerView":3}}}'
        >
          <div class="card-grid__items swiper-wrapper">
            {items.map((item) => (
              <article class="card-grid__card swiper-slide">
                {item.image ? (
                  <a
                    class="card-grid__image glightbox"
                    href={item.image}
                    data-gallery="card-grid"
                    data-title={item.name}
                  >
                    <img
                      src={item.image}
                      alt={item.imageAlt ?? item.name}
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <div
                    class="card-grid__image"
                    aria-label="Плейсхолдер изображения"
                  >
                    <div class="card-grid__image-placeholder" />
                  </div>
                )}
                <div class="card-grid__body">
                  <h3>{item.name}</h3>
                  <p>{item.text}</p>
                  {item.price && (
                    <div class="card-grid__footer">
                      <span>{label}</span>
                      <strong>{item.price}</strong>
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
          <div class="card-grid__nav" aria-label="Card slider controls">
            <button
              class="swiper-button-prev"
              type="button"
              aria-label="Предыдущая карточка"
            >
              Назад
            </button>
            <button
              class="swiper-button-next"
              type="button"
              aria-label="Следующая карточка"
            >
              Вперед
            </button>
          </div>
          <div class="swiper-pagination" />
        </div>
      )
    }
  </div>
</section>

<style>
  .card-grid {
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    background: var(--color-background, #ffffff);
  }

  .card-grid__inner {
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
  }

  .card-grid__header {
    max-width: 760px;
    margin-bottom: var(--space-10, 40px);
  }

  .card-grid h2 {
    margin: 0;
    color: var(--color-text, #000000);
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-3xl, 44px);
    line-height: var(--leading-tight, 1.12);
  }

  .card-grid__header p {
    margin: var(--space-4, 16px) 0 0;
    color: var(--color-text-muted, #000000);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-lg, 18px);
  }

  .card-grid__slider {
    position: relative;
    overflow: hidden;
    padding: 8px 2px 58px;
  }

  .card-grid__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5, 20px);
  }

  .card-grid__slider.swiper-initialized .card-grid__items {
    display: flex;
    gap: 0;
  }

  .card-grid__card {
    height: auto;
    overflow: hidden;
    border-radius: var(--radius-card, 20px);
    background: var(--color-background, #ffffff);
    box-shadow: var(--shadow-hard, 6px 6px 0 #000000);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .card-grid__card:hover {
      transform: translate(-4px, -4px);
      box-shadow: 10px 10px 0 #000000;
    }

    .card-grid__card:hover .card-grid__image img {
      transform: scale(1.05);
    }
  }

  .card-grid__image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface, #ffffff);
    color: inherit;
    text-decoration: none;
  }

  .card-grid__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-grid__image-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .card-grid__image-placeholder::before {
    position: absolute;
    inset: 26%;
    border: 2px solid #000000;
    content: "";
  }

  .card-grid__image-placeholder::after {
    position: absolute;
    top: 34%;
    left: 34%;
    width: 32px;
    height: 32px;
    border: 2px solid #000000;
    border-radius: 50%;
    background: #ffffff;
    content: "";
  }

  .card-grid__body {
    padding: var(--space-5, 20px);
  }

  .card-grid h3 {
    margin: 0 0 var(--space-3, 12px);
    color: var(--color-primary, #000000);
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-xl, 22px);
  }

  .card-grid__body p {
    margin: 0;
    min-height: 72px;
    color: var(--color-text-muted, #000000);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-sm, 14px);
    line-height: var(--leading-relaxed, 1.6);
  }

  .card-grid__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4, 16px);
    margin-top: var(--space-5, 20px);
    padding-top: var(--space-4, 16px);
    border-top: 1px solid var(--color-border, #000000);
    font-family: var(--font-body, sans-serif);
  }

  .card-grid__footer span {
    color: var(--color-text-muted, #000000);
  }

  .card-grid__footer strong {
    color: var(--color-primary, #000000);
  }

  .card-grid__nav {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    gap: 8px;
    z-index: 3;
  }

  .card-grid__nav .swiper-button-prev,
  .card-grid__nav .swiper-button-next {
    position: static;
    width: auto;
    height: 42px;
    margin: 0;
    padding: 0 14px;
    border: 1px solid #000000;
    background: #ffffff;
    color: #000000;
    font: inherit;
    font-size: var(--text-xs, 12px);
    font-weight: var(--font-bold, 700);
    text-transform: uppercase;
  }

  .card-grid__slider:not(.swiper-initialized) .card-grid__nav,
  .card-grid__slider:not(.swiper-initialized) .swiper-pagination {
    display: none;
  }

  @media (max-width: 900px) {
    .card-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 580px) {
    .card-grid__items {
      grid-template-columns: 1fr;
    }
  }

  .card-grid--equipment-lineup {
    color: var(--color-white, #ffffff);
    background: var(--color-primary-dark, #0b1f33);
  }

  .card-grid--equipment-lineup .card-grid__header {
    max-width: 820px;
    margin-bottom: 0;
  }

  .card-grid__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3, 12px);
    margin: 0 0 var(--space-4, 16px);
    color: var(--color-accent, #e76525);
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-xs, 12px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-grid__eyebrow::before {
    width: 28px;
    height: 2px;
    flex: 0 0 auto;
    background: currentColor;
    content: "";
  }

  .card-grid--equipment-lineup h2 {
    color: var(--color-white, #ffffff);
    line-height: var(--leading-tight, 1.04);
    letter-spacing: -0.035em;
  }

  .card-grid--equipment-lineup .card-grid__subline {
    max-width: 700px;
    margin-top: var(--space-4, 16px);
    color: rgb(255 255 255 / 70%);
    line-height: var(--leading-relaxed, 1.65);
  }

  .card-grid__lineup-slider {
    overflow: visible;
    margin-top: 56px;
  }

  .card-grid__lineup {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: stretch;
  }

  .card-grid__lineup-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: auto;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: var(--radius-card, 24px);
    background:
      linear-gradient(rgb(255 255 255 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 5%) 1px, transparent 1px),
      linear-gradient(145deg, #153a54, #0b263a);
    background-size:
      32px 32px,
      32px 32px,
      auto;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease;
  }

  @media (hover: hover) {
    .card-grid__lineup-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      border-color: rgb(255 255 255 / 32%);
    }

    .card-grid__lineup-item:hover .card-grid__lineup-visual img {
      transform: scale(1.05);
    }
  }

  .card-grid__lineup-visual {
    height: clamp(240px, 22vw, 310px);
    padding: 0;
    border-bottom: 1px solid rgb(255 255 255 / 28%);
    overflow: hidden;
  }

  .card-grid__lineup-visual img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-grid__lineup-body {
    padding: var(--space-5, 20px) var(--space-5, 20px) var(--space-6, 24px);
  }

  .card-grid__lineup-number {
    display: block;
    margin-bottom: var(--space-3, 12px);
    color: var(--color-accent, #e76525);
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-xs, 12px);
    font-weight: 800;
  }

  .card-grid--equipment-lineup .card-grid__lineup h3 {
    margin: 0 0 var(--space-3, 12px);
    color: var(--color-white, #ffffff);
    font-size: var(--text-lg, 18px);
    line-height: 1.2;
  }

  .card-grid__lineup-body p {
    margin: 0;
    color: rgb(255 255 255 / 68%);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-sm, 14px);
    line-height: 1.55;
  }

  @media (max-width: 1023px) {
    .card-grid__lineup-item {
      width: min(340px, calc(100vw - 60px));
    }

    .card-grid__lineup-visual {
      height: 280px;
    }
  }

  @media (max-width: 640px) {
    .card-grid__eyebrow {
      margin-bottom: var(--space-3, 12px);
      font-size: 0.68rem;
    }

    .card-grid--equipment-lineup h2 {
      font-size: clamp(2rem, 10vw, 2.55rem);
    }

    .card-grid--equipment-lineup .card-grid__subline {
      font-size: var(--text-base, 16px);
      line-height: 1.6;
    }

    .card-grid__lineup-slider {
      margin-top: 40px;
    }

    .card-grid__lineup-item {
      display: grid;
      grid-template-columns: minmax(104px, 34%) minmax(0, 1fr);
      min-height: 148px;
      border-radius: 16px;
      background: rgb(255 255 255 / 5%);
      width: calc(100vw - 40px);
    }

    .card-grid__lineup-visual {
      overflow: hidden;
      height: 100%;
      min-height: 148px;
      border-right: 1px solid rgb(255 255 255 / 12%);
      border-bottom: 0;
      background: linear-gradient(145deg, #183e58, #0b283b);
    }

    .card-grid__lineup-body {
      align-self: center;
      padding: var(--space-4, 16px);
    }

    .card-grid__lineup-number {
      margin-bottom: var(--space-2, 8px);
      font-size: 0.66rem;
    }

    .card-grid--equipment-lineup .card-grid__lineup h3 {
      margin-bottom: var(--space-2, 8px);
      font-size: 1rem;
    }

    .card-grid__lineup-body p {
      font-size: 0.78rem;
      line-height: 1.5;
    }
  }
</style>
