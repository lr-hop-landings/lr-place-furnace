---
interface Feature {
  icon?: string;
  title: string;
  text: string;
}

interface Props {
  headline: string;
  subline?: string;
  items: Feature[];
}

const { headline, subline, items } = Astro.props;
const stepCount = items.length;
---

<section class="features-grid" data-installation-route>
  <div class="features-grid__inner">
    <header class="features-grid__header">
      <p class="features-grid__eyebrow">Монтаж под ключ · {stepCount} этапов</p>
      <h2>{headline}</h2>
      {subline && <p class="features-grid__subline">{subline}</p>}
    </header>

    <ol class="features-grid__route">
      {items.map((item, index) => (
        <li
          class:list={[
            "features-grid__card",
            { "features-grid__card--milestone": index === 3 || index === 7 },
          ]}
          data-route-step={index + 1}
        >
          <span class="features-grid__number" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .features-grid {
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    background: var(--color-surface, #ffffff);
  }

  .features-grid__inner {
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
  }

  .features-grid__header {
    max-width: 760px;
    margin-bottom: var(--space-10, 40px);
  }

  .features-grid h2 {
    margin: 0;
    color: var(--color-text, #000000);
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-3xl, 44px);
    line-height: var(--leading-tight, 1.12);
  }

  .features-grid__header p {
    margin: var(--space-4, 16px) 0 0;
    color: var(--color-text-muted, #000000);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-lg, 18px);
    line-height: var(--leading-relaxed, 1.6);
  }

  .features-grid__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5, 20px);
  }

  .features-grid__card {
    padding: var(--space-6, 24px);
    border-radius: var(--radius-card, 16px);
    background: var(--color-background, #ffffff);
    box-shadow: var(--shadow-hard, 6px 6px 0 #000000);
  }

  .features-grid__icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    margin-bottom: var(--space-5, 20px);
    border-radius: var(--radius-md, 12px);
    background: var(--color-primary, #000000);
  }

  .features-grid__icon img {
    width: 26px;
    height: 26px;
    object-fit: contain;
  }

  .features-grid__icon span {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-white, #ffffff);
  }

  .features-grid h3 {
    margin: 0 0 var(--space-3, 12px);
    color: var(--color-primary, #000000);
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-lg, 18px);
    line-height: var(--leading-tight, 1.2);
  }

  .features-grid__card p {
    margin: 0;
    color: var(--color-text-muted, #000000);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-sm, 14px);
    line-height: var(--leading-relaxed, 1.6);
  }

  @media (max-width: 980px) {
    .features-grid__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .features-grid__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
