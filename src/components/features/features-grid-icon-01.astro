---
interface Feature {
  icon?: string;
  title: string;
  text: string;
}

interface Props {
  headline: string;
  subline?: string;
  items: Feature[];
  eyebrow?: string;
}

const { headline, subline, items, eyebrow } = Astro.props;
const stepCount = items.length;
const resolvedEyebrow = eyebrow ?? `Монтаж под ключ · ${stepCount} этапов`;
---

<section class="features-grid" data-installation-route>
  <div class="features-grid__inner">
    <header class="features-grid__header">
      <p class="features-grid__eyebrow">{resolvedEyebrow}</p>
      <h2>{headline}</h2>
      {subline && <p class="features-grid__subline">{subline}</p>}
    </header>

    <ol class="features-grid__route">
      {
        items.map((item, index) => (
          <li
            class:list={[
              "features-grid__card",
              { "features-grid__card--milestone": index === 3 || index === 7 },
            ]}
            data-route-step={index + 1}
          >
            <span class="features-grid__number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .features-grid {
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    background: var(--color-background, #f6f4ef);
  }

  .features-grid__inner {
    width: min(100%, var(--container-width, 1200px));
    margin: 0 auto;
  }

  .features-grid__header {
    max-width: 800px;
  }

  .features-grid__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3, 12px);
    margin: 0 0 var(--space-4, 16px);
    color: var(--color-accent, #e76525);
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-xs, 12px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .features-grid__eyebrow::before {
    width: 28px;
    height: 2px;
    flex: 0 0 auto;
    background: currentColor;
    content: "";
  }

  .features-grid h2 {
    margin: 0;
    color: var(--color-text, #152028);
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-3xl, 44px);
    line-height: var(--leading-tight, 1.04);
    letter-spacing: -0.035em;
  }

  .features-grid__subline {
    max-width: 720px;
    margin: var(--space-4, 16px) 0 0;
    color: var(--color-text-muted, #60717d);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-lg, 18px);
    line-height: var(--leading-relaxed, 1.65);
  }

  .features-grid__route {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1px;
    background: var(--color-primary-dark, #0b1f33);
    margin: 64px 0 0;
    border-radius: 10px;
    padding: 2px;
    list-style: none;
  }

  .features-grid__card {
    position: relative;
    min-width: 0;
    padding: 40px 32px;
    background: var(--color-surface, #ffffff);
    display: flex;
    grid-column: span 4;
    border-radius: 10px;
    flex-direction: column;
    z-index: 1;
    transition:
      transform 0.18s,
      border-color 0.18s,
      background-color 0.18s,
      box-shadow 0.18s;
    border: 2px solid var(--color-primary-dark, #0b1f33);
  }

  .features-grid__card:hover {
    transform: translate(-4px, -4px);
  }

  .features-grid__card:nth-child(4) {
    grid-column: span 8;
  }
  .features-grid__card:nth-child(6),
  .features-grid__card:nth-child(7) {
    grid-column: span 3;
  }
  .features-grid__card:nth-child(8) {
    grid-column: span 6;
  }

  .features-grid__card:nth-child(4),
  .features-grid__card:nth-child(8) {
    &:hover {
      border-color: #e76525;
      /* box-shadow: 4px 4px 0 0 #e76525; */
      & > h3 {
        color: var(--color-accent);
      }
    }
  }

  .features-grid__number {
    display: flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--color-white, #ffffff);
    background: var(--color-primary-dark, #0b1f33);
    font-family: var(--font-heading, sans-serif);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    transition: all 0.18s;
    margin-bottom: var(--space-4, 16px);
  }

  .features-grid__card--milestone .features-grid__number {
    background: var(--color-accent, #e76525);
  }

  .features-grid__card--milestone h3 {
    color: var(--color-accent, #e76525);
  }

  .features-grid h3,
  .features-grid__card > p {
    position: relative;
    z-index: 1;
    transition: color 0.18s;
  }

  .features-grid h3 {
    margin: 0 0 var(--space-3, 12px);
    color: var(--color-primary-dark, #0b1f33);
    font-family: var(--font-heading, sans-serif);
    font-size: 1.25rem;
    line-height: 1.2;
    font-weight: 700;
  }

  .features-grid__card > p {
    margin: 0;
    color: var(--color-text-muted, #60717d);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-sm, 14px);
    line-height: 1.55;
  }

  @media (max-width: 1023px) {
    .features-grid__route {
      grid-template-columns: repeat(2, 1fr);
    }

    .features-grid__card {
      grid-column: span 1 !important;
      padding: 32px 24px;
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      padding-right: var(--space-4, 16px);
      padding-left: var(--space-4, 16px);
    }

    .features-grid__eyebrow {
      margin-bottom: var(--space-3, 12px);
      font-size: 0.68rem;
    }

    .features-grid h2 {
      font-size: clamp(2rem, 10vw, 2.55rem);
    }

    .features-grid__subline {
      font-size: var(--text-base, 16px);
      line-height: 1.6;
    }

    .features-grid__route {
      grid-template-columns: 1fr;
      gap: 1px;
      margin-top: 40px;
      padding-left: 0;
    }

    .features-grid__card {
      padding: 24px 20px;
    }

    .features-grid__number {
      margin-bottom: 12px;
    }

    .features-grid h3 {
      margin-bottom: var(--space-2, 8px);
      font-size: 1rem;
    }

    .features-grid__card > p {
      font-size: 0.82rem;
      line-height: 1.5;
    }
  }
</style>
