---
interface Pill {
  text: string;
}

interface Props {
  headline: string;
  accent?: string;
  subline: string;
  cta: string;
  ctaHref?: string;
  priceBadge?: string;
  pills?: Pill[];
  imageSrc?: string;
  imageAlt?: string;
  backgroundImageSrc?: string;
}

const {
  headline,
  accent,
  subline,
  cta,
  ctaHref = "#contacts",
  priceBadge,
  pills = [],
  imageSrc,
  imageAlt = "",
  backgroundImageSrc,
} = Astro.props;

const callouts = [
  { label: "Защита стены", position: "wall" },
  { label: "Дымоход", position: "chimney" },
  { label: "Основание", position: "base" },
];
---

<section
  class="hero-visual"
  data-hero-enhanced
  style={backgroundImageSrc ? `--hero-bg-image: url("${backgroundImageSrc}")` : undefined}
>
  <div class="hero-visual__inner">
    <div class="hero-visual__content">
      {priceBadge && <a class="hero-visual__badge" href={ctaHref}>{priceBadge}</a>}
      <h1 class="hero-visual__headline">
        {headline}
        {accent && <span>{accent}</span>}
      </h1>
      <p class="hero-visual__subline">{subline}</p>
      <div class="hero-visual__actions">
        <a class="hero-visual__button" href={ctaHref}>{cta}</a>
        <a class="hero-visual__phone" href="tel:+78123444444">+7 (812) 344-44-44</a>
      </div>
      {pills.length > 0 && (
        <ul class="hero-visual__pills" aria-label="Key benefits">
          {pills.map((pill) => <li>{pill.text}</li>)}
        </ul>
      )}
    </div>
    <div class="hero-visual__media-shell">
      {imageSrc ? (
        <a class="hero-visual__media glightbox" href={imageSrc} data-gallery="hero-visual" data-title={headline} aria-label={imageAlt || "Открыть изображение первого экрана"}>
          <img
            src={imageSrc}
            alt={imageAlt}
            width="1280"
            height="1600"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </a>
      ) : (
        <div class="hero-visual__media" aria-label="Инженерная схема установки металлической печи">
          <div class="hero-visual__blueprint" aria-hidden="true">
            <span class="hero-visual__blueprint-label">Согласованный монтажный узел</span>
            <div class="hero-visual__chimney"><i></i><i></i><i></i></div>
            <div class="hero-visual__stove"><b></b><span></span></div>
            <div class="hero-visual__floor"></div>
            <small class="hero-visual__note hero-visual__note--one">дымоход</small>
            <small class="hero-visual__note hero-visual__note--two">защита стены</small>
            <small class="hero-visual__note hero-visual__note--three">основание</small>
          </div>
        </div>
      )}
      <ul class="hero-visual__callouts" aria-label="Ключевые элементы монтажного узла">
        {callouts.map((callout) => (
          <li class={`hero-visual__callout hero-visual__callout--${callout.position}`}>
            {callout.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero-visual {
    position: relative;
    overflow: hidden;
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    color: var(--color-text, #000000);
    background: var(--color-background, #ffffff);
    background-size: cover;
    background-position: center;
  }

  .hero-visual__inner {
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 1fr);
    gap: var(--space-16, 64px);
    align-items: center;
  }

  .hero-visual__content {
    position: relative;
    z-index: 1;
  }

  .hero-visual__badge {
    display: inline-flex;
    width: fit-content;
    margin-bottom: var(--space-6, 24px);
    padding: 10px 18px;
    border-radius: var(--radius-full, 999px);
    background: var(--color-primary, #000000);
    color: var(--color-white, #ffffff);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-sm, 14px);
    font-weight: var(--font-semibold, 600);
    text-decoration: none;
  }

  .hero-visual__headline {
    margin: 0;
    max-width: 780px;
    color: var(--color-text, #000000);
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(36px, 6vw, 68px);
    line-height: var(--leading-tight, 1.08);
    font-weight: var(--font-bold, 700);
    letter-spacing: 0;
  }

  .hero-visual__headline span {
    display: block;
    color: var(--color-primary, #000000);
  }

  .hero-visual__subline {
    max-width: 620px;
    margin: var(--space-6, 24px) 0 0;
    color: var(--color-text-muted, #000000);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-lg, 18px);
    line-height: var(--leading-relaxed, 1.65);
  }

  .hero-visual__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    margin-top: var(--space-8, 32px);
  }

  .hero-visual__phone {
    color: var(--color-primary, #123a5a);
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-lg, 18px);
    font-weight: 800;
    text-decoration: none;
  }

  .hero-visual__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 28px;
    border-radius: var(--radius-button, 14px);
    background: var(--color-accent, #000000);
    color: var(--color-white, #ffffff);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-base, 16px);
    font-weight: var(--font-semibold, 600);
    text-decoration: none;
    box-shadow: var(--shadow-hard, 6px 6px 0 #000000);
  }

  .hero-visual__pills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3, 12px);
    max-width: 560px;
    margin: var(--space-10, 40px) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-visual__pills li {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    min-height: 46px;
    padding: 12px 16px;
    border-radius: var(--radius-full, 999px);
    background: var(--color-background, #ffffff);
    color: var(--color-text, #000000);
    font-family: var(--font-body, sans-serif);
    font-size: var(--text-sm, 14px);
    box-shadow: var(--shadow-hard, 6px 6px 0 #000000);
  }

  .hero-visual__pills li::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-primary, #000000);
    flex: 0 0 auto;
  }

  .hero-visual__media {
    color: inherit;
    text-decoration: none;
  }

  .hero-visual__media-shell {
    position: relative;
    min-width: 0;
  }

  .hero-visual__callouts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-visual__media img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .hero-visual__image-placeholder {
    position: relative;
    min-height: 360px;
    border: 2px solid #000000;
    background: #e5e5e5;
  }

  .hero-visual__blueprint {
    position: relative;
    width: 100%;
    min-height: 560px;
    overflow: hidden;
    border-radius: var(--radius-card, 24px);
    background: linear-gradient(rgb(255 255 255 / 7%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 7%) 1px, transparent 1px), var(--color-primary-dark, #0b1f33);
    background-size: 32px 32px;
    box-shadow: var(--shadow-soft);
  }

  .hero-visual__blueprint::after {
    position: absolute;
    inset: 18% 12% 12%;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 50% 50% 12% 12%;
    content: "";
  }

  .hero-visual__blueprint-label {
    position: absolute;
    top: 28px;
    left: 28px;
    color: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .hero-visual__chimney {
    position: absolute;
    top: 80px;
    left: 50%;
    z-index: 2;
    width: 76px;
    height: 265px;
    transform: translateX(-50%);
    border: 2px solid #fff;
    background: linear-gradient(90deg, #8795a0, #f8fafb 45%, #73828e);
  }

  .hero-visual__chimney i { display: block; height: 33.333%; border-bottom: 2px solid #273640; }

  .hero-visual__stove {
    position: absolute;
    bottom: 86px;
    left: 50%;
    z-index: 3;
    width: 220px;
    height: 230px;
    transform: translateX(-50%);
    border: 3px solid #0b1f33;
    border-radius: 22px 22px 12px 12px;
    background: linear-gradient(135deg, #394650, #121a20 70%);
    box-shadow: 0 28px 50px rgb(0 0 0 / 38%);
  }

  .hero-visual__stove b {
    position: absolute;
    inset: 38px 32px 72px;
    border: 3px solid #7a8790;
    border-radius: 50% 50% 16px 16px;
    background: radial-gradient(circle at 50% 80%, #ff9a4b, #b93815 35%, #1b1718 72%);
  }

  .hero-visual__stove span { position: absolute; right: 28px; bottom: 32px; width: 54px; height: 8px; border-radius: 999px; background: #8c979e; }
  .hero-visual__floor { position: absolute; right: 14%; bottom: 54px; left: 14%; height: 52px; transform: perspective(180px) rotateX(36deg); border: 2px solid #fff; background: rgb(231 101 37 / 74%); }
  .hero-visual__note { position: absolute; z-index: 4; padding: 7px 10px; border: 1px solid rgb(255 255 255 / 40%); border-radius: 999px; color: #fff; background: rgb(11 31 51 / 78%); font-family: var(--font-body); font-size: 12px; }
  .hero-visual__note--one { top: 150px; right: 22px; }
  .hero-visual__note--two { top: 300px; left: 20px; }
  .hero-visual__note--three { right: 20px; bottom: 54px; }

  .hero-visual__image-placeholder::before {
    position: absolute;
    inset: 28%;
    border: 2px solid #000000;
    content: "";
  }

  .hero-visual__image-placeholder::after {
    position: absolute;
    top: 34%;
    left: 34%;
    width: 38px;
    height: 38px;
    border: 2px solid #000000;
    border-radius: 50%;
    background: #ffffff;
    content: "";
  }

  @media (max-width: 820px) {
    .hero-visual {
      padding-top: var(--space-16, 64px);
      padding-bottom: var(--space-16, 64px);
    }

    .hero-visual__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8, 32px);
    }

    .hero-visual__media {
      order: -1;
    }

    .hero-visual__pills {
      grid-template-columns: 1fr;
    }

    .hero-visual__button {
      width: 100%;
    }

    .hero-visual__phone { width: 100%; text-align: center; }
    .hero-visual__blueprint { min-height: 430px; }
  }
</style>
