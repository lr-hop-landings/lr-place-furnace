---
interface Pill {
  text: string;
}

interface Callout {
  label: string;
  description: string;
  position: "wall" | "chimney" | "base";
  tooltipSide: "left" | "right" | "above" | "below";
  x: number;
  y: number;
  mobileX?: number;
  mobileY?: number;
}

interface Props {
  headline: string;
  accent?: string;
  subline: string;
  cta: string;
  ctaHref?: string;
  priceBadge?: string;
  pills?: Pill[];
  imageSrc?: string;
  imageAlt?: string;
  imagePositionMobile?: string;
  backgroundImageSrc?: string;
  callouts?: Callout[];
}

const {
  headline,
  accent,
  subline,
  cta,
  ctaHref = "#contacts",
  priceBadge,
  pills = [],
  imageSrc,
  imageAlt = "",
  imagePositionMobile = "center",
  backgroundImageSrc,
  callouts,
} = Astro.props;

const resolvedCallouts = callouts ?? [
  { label: "Защита стены", description: "Негорючая панель закрывает стену в зоне нагрева.", position: "wall", tooltipSide: "left", x: 73, y: 49, mobileX: 74, mobileY: 38 },
  { label: "Дымоход", description: "Стальной дымоход проходит вертикально от печи через перекрытие.", position: "chimney", tooltipSide: "below", x: 59, y: 29, mobileX: 59, mobileY: 17 },
  { label: "Основание", description: "Негорючее основание защищает пол перед топкой.", position: "base", tooltipSide: "above", x: 58, y: 88, mobileX: 58, mobileY: 82 },
] satisfies Callout[];

const heroStyle = [
  backgroundImageSrc ? `--hero-bg-image: url("${backgroundImageSrc}")` : "",
  `--hero-image-position-mobile: ${imagePositionMobile}`,
]
  .filter(Boolean)
  .join("; ");
---

<section
  class="hero-visual"
  data-hero-enhanced
  style={heroStyle}
>
  <div class="hero-visual__inner">
    <div class="hero-visual__content">
      {
        priceBadge && (
          <a class="hero-visual__badge" href={ctaHref}>
            {priceBadge}
          </a>
        )
      }
      <h1 class="hero-visual__headline">
        {headline}
        {" "}
        {accent && <span>{accent}</span>}
      </h1>
      <p class="hero-visual__subline">{subline}</p>
      <div class="hero-visual__actions">
        <a class="hero-visual__button" href={ctaHref}>{cta}</a>
        <a class="hero-visual__phone" href="tel:+78123444444"
          >+7 (812) 344-44-44</a
        >
      </div>
      {
        pills.length > 0 && (
          <ul class="hero-visual__pills" aria-label="Key benefits">
            {pills.map((pill) => (
              <li>{pill.text}</li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="hero-visual__media-shell">
      <div class="hero-visual__media-frame">
        {
          imageSrc ? (
            <div class="hero-visual__media">
              <img
                src={imageSrc}
                alt={imageAlt}
                width="1280"
                height="1600"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          ) : (
            <div
              class="hero-visual__media"
              aria-label="Инженерная схема печного узла"
            >
              <div class="hero-visual__blueprint" aria-hidden="true">
                <span class="hero-visual__blueprint-label">
                  Согласованный монтажный узел
                </span>
                <div class="hero-visual__chimney">
                  <>
                    <i />
                    <i />
                    <i />
                  </>
                </div>
                <div class="hero-visual__stove">
                  <>
                    <b />
                    <span />
                  </>
                </div>
                <div class="hero-visual__floor" />
              </div>
            </div>
          )
        }
        <ul
          class="hero-visual__callouts"
          aria-label="Ключевые элементы печного узла"
        >
          {
            resolvedCallouts.map((callout, index) => (
              <li
                class={`hero-visual__callout hero-visual__callout--${callout.position} hero-visual__callout--tooltip-${callout.tooltipSide}`}
                style={`--callout-x: ${callout.x}%; --callout-y: ${callout.y}%; --callout-mobile-x: ${callout.mobileX ?? callout.x}%; --callout-mobile-y: ${callout.mobileY ?? callout.y}%`}
              >
                <details name="hero-callout">
                  <summary aria-label={`${index + 1}. ${callout.label}`}>
                    <span aria-hidden="true">{index + 1}</span>
                  </summary>
                  <div class="hero-visual__tooltip" role="tooltip">
                    <strong>{callout.label}</strong>
                    <p>{callout.description}</p>
                  </div>
                </details>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-visual {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(72px, 8vw, 116px) var(--space-4, 16px) 32px;
    color: var(--color-text, #152028);
    background: var(--color-background, #f6f4ef);
    background-size: cover;
    background-position: center;
  }

  .hero-visual::before {
    position: absolute;
    z-index: -1;
    inset: 0 40% 0 0;
    background-image: radial-gradient(
      rgb(18 58 90 / 13%) 0.7px,
      transparent 0.7px
    );
    background-size: 13px 13px;
    mask-image: linear-gradient(90deg, #000, transparent 92%);
    content: "";
  }

  .hero-visual__inner {
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(360px, 0.82fr);
    gap: clamp(40px, 6vw, 76px);
    align-items: center;
  }

  .hero-visual__content {
    position: relative;
    z-index: 1;
    min-width: 0;
    animation: hero-copy-reveal 620ms both cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .hero-visual__badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    width: fit-content;
    margin-bottom: var(--space-6, 24px);
    padding: 8px 12px;
    border: 1px solid var(--color-border, #d6dee3);
    border-radius: var(--radius-full, 999px);
    background: rgb(255 255 255 / 72%);
    color: var(--color-primary, #123a5a);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .hero-visual__badge::before {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-accent, #e76525);
    box-shadow: 0 0 0 4px rgb(231 101 37 / 14%);
    content: "";
  }

  .hero-visual__headline {
    margin: 0;
    max-width: 760px;
    color: var(--color-text, #152028);
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(42px, 5.4vw, 70px);
    line-height: 0.98;
    font-weight: 760;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .hero-visual__headline span {
    display: block;
    color: var(--color-primary, #000000);
  }

  .hero-visual__subline {
    max-width: 610px;
    margin: var(--space-6, 24px) 0 0;
    color: var(--color-text-muted, #60717d);
    font-size: clamp(16px, 1.45vw, 18px);
    line-height: 1.58;
  }

  .hero-visual__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    margin-top: var(--space-8, 32px);
  }

  .hero-visual__phone {
    color: var(--color-primary, #123a5a);
    font-family: var(--font-heading, sans-serif);
    font-size: var(--text-lg, 18px);
    font-weight: 800;
    text-decoration: none;
  }

  .hero-visual__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 26px;
    border-radius: 10px;
    background: var(--color-accent, #e76525);
    color: var(--color-white, #fff);
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 6px 0 #b84916;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .hero-visual__button:hover {
    transform: translateY(2px);
    box-shadow: 0 4px 0 #b84916;
  }

  .hero-visual__button:focus-visible,
  .hero-visual__phone:focus-visible,
  .hero-visual__badge:focus-visible {
    outline: 3px solid var(--color-accent, #e76525);
    outline-offset: 4px;
  }

  .hero-visual__pills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    max-width: 610px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-visual__pills li {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    padding: 10px 12px;
    border-left: 2px solid var(--color-primary, #123a5a);
    border-radius: 0 11px 11px 0;
    background: rgb(255 255 255 / 72%);
    color: var(--color-text, #152028);
    font-size: 13px;
    font-weight: 650;
    box-shadow: none;
  }

  .hero-visual__pills li::before {
    display: grid;
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: rgb(231 101 37 / 14%);
    color: var(--color-accent, #e76525);
    font-size: 11px;
    font-weight: 900;
    content: "✓";
  }

  .hero-visual__media-frame {
    position: relative;
    height: clamp(470px, 45vw, 570px);
    container-type: inline-size;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: var(--radius-card, 24px);
    background: var(--color-primary-dark, #0b1f33);
    box-shadow: 0 26px 55px rgb(11 31 51 / 22%);
  }

  .hero-visual__media {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .hero-visual__media-shell {
    position: relative;
    min-width: 0;
    animation: hero-media-reveal 700ms 120ms both
      cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .hero-visual__callouts {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    pointer-events: none;
    list-style: none;
  }

  .hero-visual__callout {
    position: absolute;
    z-index: 4;
    top: var(--callout-y);
    left: var(--callout-x);
    transform: translate(-50%, -50%);
    pointer-events: auto;
  }

  .hero-visual__callout details {
    position: relative;
  }

  .hero-visual__callout summary {
    position: relative;
    z-index: 2;
    display: grid;
    width: clamp(30px, 7.8cqi, 38px);
    aspect-ratio: 1;
    place-items: center;
    cursor: pointer;
    border: 2px solid #fff;
    border-radius: 50%;
    color: #fff;
    background: var(--color-accent, #e76525);
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(12px, 3cqi, 15px);
    font-weight: 850;
    line-height: 1;
    list-style: none;
    box-shadow:
      0 7px 18px rgb(11 31 51 / 30%),
      0 0 0 5px rgb(231 101 37 / 20%);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .hero-visual__callout summary::-webkit-details-marker {
    display: none;
  }

  .hero-visual__callout summary::after {
    position: absolute;
    inset: -7px;
    border: 1px solid rgb(255 255 255 / 65%);
    border-radius: inherit;
    animation: hero-hotspot-pulse 2.4s ease-out infinite;
    content: "";
  }

  .hero-visual__callout summary:hover,
  .hero-visual__callout details[open] summary {
    transform: scale(1.08);
    box-shadow:
      0 9px 22px rgb(11 31 51 / 34%),
      0 0 0 6px rgb(231 101 37 / 25%);
  }

  .hero-visual__callout summary:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  .hero-visual__tooltip {
    position: absolute;
    z-index: 1;
    width: clamp(185px, 52cqi, 236px);
    padding: clamp(14px, 3.6cqi, 18px);
    border: 1px solid rgb(255 255 255 / 78%);
    border-radius: clamp(16px, 4cqi, 22px);
    visibility: hidden;
    color: var(--color-text, #152028);
    background: rgb(255 255 255 / 96%);
    box-shadow: 0 18px 45px rgb(11 31 51 / 28%);
    opacity: 0;
    pointer-events: none;
    transform: var(--tooltip-transform-closed);
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms ease;
    backdrop-filter: blur(12px);
  }

  .hero-visual__tooltip strong {
    display: block;
    color: var(--color-primary, #123a5a);
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(14px, 3.5cqi, 17px);
    line-height: 1.12;
  }

  .hero-visual__tooltip p {
    margin: 8px 0 0;
    color: var(--color-text-muted, #60717d);
    font-size: clamp(11px, 2.8cqi, 14px);
    line-height: 1.42;
  }

  .hero-visual__callout details[open] .hero-visual__tooltip,
  .hero-visual__callout:hover .hero-visual__tooltip,
  .hero-visual__callout summary:focus-visible + .hero-visual__tooltip {
    visibility: visible;
    opacity: 1;
    transform: var(--tooltip-transform-open);
  }

  .hero-visual__callout--tooltip-left .hero-visual__tooltip {
    top: 50%;
    right: calc(100% + 12px);
    --tooltip-transform-closed: translate(8px, -50%);
    --tooltip-transform-open: translate(0, -50%);
  }

  .hero-visual__callout--tooltip-right .hero-visual__tooltip {
    top: 50%;
    left: calc(100% + 12px);
    --tooltip-transform-closed: translate(-8px, -50%);
    --tooltip-transform-open: translate(0, -50%);
  }

  .hero-visual__callout--tooltip-below .hero-visual__tooltip {
    top: calc(100% + 12px);
    left: 50%;
    --tooltip-transform-closed: translate(-50%, -8px);
    --tooltip-transform-open: translate(-50%, 0);
  }

  .hero-visual__callout--tooltip-above .hero-visual__tooltip {
    bottom: calc(100% + 12px);
    left: 50%;
    --tooltip-transform-closed: translate(-50%, 8px);
    --tooltip-transform-open: translate(-50%, 0);
  }

  @keyframes hero-hotspot-pulse {
    0%,
    45% {
      opacity: 0.7;
      transform: scale(0.88);
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(1.28);
    }
  }

  .hero-visual__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .hero-visual__image-placeholder {
    position: relative;
    min-height: 360px;
    border: 2px solid #000000;
    background: #e5e5e5;
  }

  .hero-visual__blueprint {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    border-radius: var(--radius-card, 24px);
    background:
      linear-gradient(rgb(255 255 255 / 7%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 7%) 1px, transparent 1px),
      var(--color-primary-dark, #0b1f33);
    background-size: 32px 32px;
    box-shadow: var(--shadow-soft);
  }

  .hero-visual__blueprint::after {
    position: absolute;
    inset: 18% 12% 12%;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 50% 50% 12% 12%;
    content: "";
  }

  .hero-visual__blueprint-label {
    position: absolute;
    top: 28px;
    left: 28px;
    color: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-visual__chimney {
    position: absolute;
    top: 80px;
    left: 50%;
    z-index: 2;
    width: 76px;
    height: 265px;
    transform: translateX(-50%);
    border: 2px solid #fff;
    background: linear-gradient(90deg, #8795a0, #f8fafb 45%, #73828e);
  }

  .hero-visual__chimney i {
    display: block;
    height: 33.333%;
    border-bottom: 2px solid #273640;
  }

  .hero-visual__stove {
    position: absolute;
    bottom: 86px;
    left: 50%;
    z-index: 3;
    width: 220px;
    height: 230px;
    transform: translateX(-50%);
    border: 3px solid #0b1f33;
    border-radius: 22px 22px 12px 12px;
    background: linear-gradient(135deg, #394650, #121a20 70%);
    box-shadow: 0 28px 50px rgb(0 0 0 / 38%);
  }

  .hero-visual__stove b {
    position: absolute;
    inset: 38px 32px 72px;
    border: 3px solid #7a8790;
    border-radius: 50% 50% 16px 16px;
    background: radial-gradient(
      circle at 50% 80%,
      #ff9a4b,
      #b93815 35%,
      #1b1718 72%
    );
  }

  .hero-visual__stove span {
    position: absolute;
    right: 28px;
    bottom: 32px;
    width: 54px;
    height: 8px;
    border-radius: 999px;
    background: #8c979e;
  }
  .hero-visual__floor {
    position: absolute;
    right: 14%;
    bottom: 54px;
    left: 14%;
    height: 52px;
    transform: perspective(180px) rotateX(36deg);
    border: 2px solid #fff;
    background: rgb(231 101 37 / 74%);
  }

  .hero-visual__image-placeholder::before {
    position: absolute;
    inset: 28%;
    border: 2px solid #000000;
    content: "";
  }

  .hero-visual__image-placeholder::after {
    position: absolute;
    top: 34%;
    left: 34%;
    width: 38px;
    height: 38px;
    border: 2px solid #000000;
    border-radius: 50%;
    background: #ffffff;
    content: "";
  }

  @keyframes hero-copy-reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-media-reveal {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 820px) {
    .hero-visual {
      padding-top: 0;
      padding-bottom: 32px;
    }

    .hero-visual::before {
      inset: 34% 0 0;
    }

    .hero-visual__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .hero-visual__media-shell {
      order: -1;
      margin-inline: -16px;
    }

    .hero-visual__media-frame {
      height: clamp(230px, 62vw, 320px);
      border-radius: 0 0 22px 22px;
    }

    .hero-visual__media img {
      object-position: var(--hero-image-position-mobile);
    }

    .hero-visual__callout {
      top: var(--callout-mobile-y);
      left: var(--callout-mobile-x);
    }

    .hero-visual__content {
      padding-top: 4px;
    }

    .hero-visual__headline {
      font-size: clamp(36px, 10vw, 48px);
      line-height: 0.98;
    }

    .hero-visual__actions {
      gap: 16px;
    }

    .hero-visual__button {
      width: 100%;
    }
    .hero-visual__phone {
      width: 100%;
      text-align: center;
    }
    .hero-visual__pills {
      margin-top: 28px;
    }
    .hero-visual__blueprint {
      min-height: 100%;
    }
  }

  @media (max-width: 480px) {
    .hero-visual__pills {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual__content,
    .hero-visual__media-shell {
      animation: none;
    }

    .hero-visual__button {
      transition: none;
    }

    .hero-visual__callout summary::after {
      animation: none;
    }

    .hero-visual__callout summary,
    .hero-visual__tooltip {
      transition: none;
    }
  }
</style>
