---
import QuizForm from "./lead-quiz-form.astro";

interface QuizStep {
  question: string;
  options: string[];
}

interface Props {
  id?: string;
  badge?: string;
  headline: string;
  subline?: string;
  triggerText: string;
  steps: QuizStep[];
  submitText?: string;
  privacyText?: string;
}

const {
  id = "estimate-quiz",
  badge,
  headline,
  subline,
  steps,
  submitText = "Получить расчёт монтажа",
  privacyText = "Нажимая кнопку, вы соглашаетесь на обработку персональных данных.",
} = Astro.props;
---

<section class="lead-quiz" data-lead-quiz={id} id={id} aria-labelledby={`${id}-title`}>
  <div class="lead-quiz__layout">
    <div class="lead-quiz__copy">
      {badge && <p class="lead-quiz__badge">{badge}</p>}
      <h2 id={`${id}-title`}>{headline}</h2>
      {subline && <p class="lead-quiz__subline">{subline}</p>}
      <ul>
        <li>Предварительный состав работ</li>
        <li>Список недостающих данных</li>
        <li>Рекомендация: расчёт по фото или выезд</li>
      </ul>
    </div>

    <QuizForm
      instance="inline"
      quizId={id}
      steps={steps}
      submitText={submitText}
      privacyText={privacyText}
    />
  </div>

  <div class="lead-quiz__modal" data-quiz-modal aria-hidden="true">
    <div class="lead-quiz__dialog" role="dialog" aria-modal="true" aria-labelledby={`${id}-modal-title`}>
      <h2 id={`${id}-modal-title`} class="lead-quiz__visually-hidden">Расчёт монтажа</h2>
      <button class="lead-quiz__close" type="button" data-quiz-close aria-label="Закрыть квиз">×</button>
      <QuizForm
        instance="modal"
        quizId={id}
        steps={steps}
        submitText={submitText}
        privacyText={privacyText}
      />
    </div>
  </div>
</section>

<style>
  .lead-quiz {
    padding: var(--spacing-section, 96px) var(--space-4, 16px);
    background:
      radial-gradient(circle at 88% 14%, rgb(231 101 37 / 16%), transparent 26%),
      linear-gradient(145deg, #0b2134, var(--color-primary-dark, #0b1f33));
    color: var(--color-white, #ffffff);
  }

  .lead-quiz__layout {
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(520px, 1.18fr);
    gap: clamp(40px, 6vw, 84px);
    align-items: center;
    width: min(100%, var(--container-width, 1180px));
    margin: 0 auto;
  }

  .lead-quiz__copy { max-width: 520px; }

  .lead-quiz__badge {
    display: inline-flex;
    margin: 0 0 18px;
    padding: 8px 12px;
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 999px;
    color: #ffd2ba;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .lead-quiz__copy h2 {
    margin: 0;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(38px, 4.8vw, 64px);
    line-height: 1.02;
    letter-spacing: -.04em;
  }

  .lead-quiz__subline {
    max-width: 500px;
    margin: 20px 0 0;
    color: rgb(255 255 255 / 72%);
    font-size: var(--text-lg, 18px);
    line-height: 1.65;
  }

  .lead-quiz__copy ul {
    display: grid;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .lead-quiz__copy li {
    display: flex;
    gap: 10px;
    align-items: center;
    color: rgb(255 255 255 / 86%);
    font-size: 14px;
    font-weight: 700;
  }

  .lead-quiz__copy li::before {
    content: "✓";
    color: #ff9b6a;
    font-weight: 800;
  }

  .lead-quiz__modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    place-items: center;
    padding: 18px;
    background: rgb(5 15 24 / 88%);
    backdrop-filter: blur(10px);
  }

  .lead-quiz__modal.is-open { display: grid; }

  .lead-quiz__dialog {
    position: relative;
    width: min(100%, 820px);
    max-height: 94vh;
    overflow: auto;
    border-radius: 22px;
    box-shadow: 0 30px 90px rgb(0 0 0 / 42%);
    scrollbar-width: none;
  }

  .lead-quiz__dialog::-webkit-scrollbar { display: none; }

  .lead-quiz__close {
    position: absolute;
    top: 13px;
    right: 13px;
    z-index: 2;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    color: var(--color-text, #152028);
    background: var(--color-background, #f6f4ef);
    cursor: pointer;
    font-size: 26px;
  }

  .lead-quiz__close:focus-visible {
    outline: 3px solid var(--color-accent, #e76525);
    outline-offset: 3px;
  }

  .lead-quiz__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 980px) {
    .lead-quiz__layout {
      grid-template-columns: 1fr;
      gap: 38px;
    }
    .lead-quiz__copy { max-width: 720px; }
  }

  @media (max-width: 760px) {
    .lead-quiz { padding: 56px var(--space-4, 16px) 64px; }
    .lead-quiz__copy h2 { font-size: clamp(34px, 10vw, 46px); }
    .lead-quiz__modal { padding: 10px; align-items: center; }
    .lead-quiz__dialog { max-height: 96vh; border-radius: 18px; }
    .lead-quiz__close { top: 8px; right: 8px; }
  }
</style>
