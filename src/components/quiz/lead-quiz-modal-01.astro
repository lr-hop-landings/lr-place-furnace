---
interface QuizStep {
  question: string;
  options: string[];
}

interface Props {
  id?: string;
  badge?: string;
  headline: string;
  subline?: string;
  triggerText: string;
  steps: QuizStep[];
  submitText?: string;
  privacyText?: string;
}

const {
  id = "estimate-quiz",
  badge,
  headline,
  subline,
  triggerText,
  steps,
  submitText = "Получить расчёт монтажа",
  privacyText = "Нажимая кнопку, вы соглашаетесь на обработку персональных данных.",
} = Astro.props;

const stepNames = ["object_type", "house_type", "stove_status", "services[]", "chimney_route"];
---

<section class="lead-quiz" data-lead-quiz={id} id={id} aria-labelledby={`${id}-title`}>
  <div class="lead-quiz__inner">
    <div class="lead-quiz__copy">
      {badge && <p class="lead-quiz__badge">{badge}</p>}
      <h2 id={`${id}-title`}>{headline}</h2>
      {subline && <p class="lead-quiz__subline">{subline}</p>}
      <ul>
        <li>Предварительный состав работ</li>
        <li>Список недостающих данных</li>
        <li>Рекомендация: расчёт по фото или выезд</li>
      </ul>
    </div>
    <button class="lead-quiz__trigger" type="button" data-quiz-open>{triggerText}</button>
  </div>

  <div class="lead-quiz__modal" data-quiz-modal aria-hidden="true">
    <div class="lead-quiz__dialog" role="dialog" aria-modal="true" aria-labelledby={`${id}-dialog-title`}>
      <button class="lead-quiz__close" type="button" data-quiz-close aria-label="Закрыть квиз">×</button>
      <p class="lead-quiz__step-label" data-quiz-step-label>Шаг 1 из 6</p>
      <h2 id={`${id}-dialog-title`}>Расчёт монтажа</h2>
      <div class="lead-quiz__progress" role="progressbar" aria-valuemin="1" aria-valuemax="6" aria-valuenow="1"><span data-quiz-progress></span></div>

      <div data-lead-root>
        <form class="lead-quiz__form" data-hop-lead-form novalidate>
          <input type="hidden" name="quiz_service" value="Установка металлической печи" />
          <input type="hidden" name="phone" data-phone-value value="" />
          {steps.map((step, index) => (
            <fieldset class={`lead-quiz__step ${index === 0 ? "is-active" : ""}`} data-quiz-step>
              <legend>{step.question}</legend>
              <div class="lead-quiz__options">
                {step.options.map((option) => (
                  <label>
                    <input
                      type={index === 3 ? "checkbox" : "radio"}
                      name={stepNames[index]}
                      value={option}
                    />
                    <span>{option}</span>
                  </label>
                ))}
              </div>
              <p class="lead-quiz__error" data-step-error hidden>Выберите подходящий вариант.</p>
            </fieldset>
          ))}

          <fieldset class="lead-quiz__step" data-quiz-step>
            <legend>Куда отправить предварительный расчёт?</legend>
            <div class="lead-quiz__fields">
              <label class="lead-quiz__name-field">
                <span>Имя</span>
                <input type="text" name="name" autocomplete="name" placeholder="Как к вам обращаться" />
              </label>
              <label class="lead-quiz__desktop-phone">
                <span>Телефон *</span>
                <input type="tel" data-phone-input autocomplete="tel" inputmode="tel" placeholder="+7 (___) ___-__-__" />
              </label>
              <div class="lead-quiz__dialpad" data-dialpad>
                <span>Телефон *</span>
                <output data-dialpad-display aria-live="polite">+7</output>
                <div class="lead-quiz__keys" aria-label="Цифровая клавиатура">
                  {[1,2,3,4,5,6,7,8,9].map((digit) => <button type="button" data-digit={digit}>{digit}</button>)}
                  <button type="button" data-clear aria-label="Очистить номер">C</button>
                  <button type="button" data-digit="0">0</button>
                  <button type="button" data-backspace aria-label="Удалить последнюю цифру">⌫</button>
                </div>
              </div>
              <label>
                <span>Населённый пункт *</span>
                <input type="text" name="location" autocomplete="address-level2" required placeholder="Например, Всеволожск" />
              </label>
              <label>
                <span>Модель печи</span>
                <input type="text" name="stove_model" placeholder="Название или модель" />
              </label>
              <label>
                <span>Фотографии</span>
                <input type="file" name="photos[]" multiple accept="image/jpeg,image/png,image/webp,image/heic,image/heif" />
              </label>
              <fieldset class="lead-quiz__contact-method">
                <legend>Удобный способ ответа</legend>
                <label><input type="radio" name="contact_method" value="Звонок" checked /> Звонок</label>
                <label><input type="radio" name="contact_method" value="VK" /> VK</label>
                <label><input type="radio" name="contact_method" value="Telegram" /> Telegram</label>
                <label><input type="radio" name="contact_method" value="MAX" /> MAX</label>
              </fieldset>
              <label>
                <span>Комментарий</span>
                <textarea name="comment" placeholder="Что важно учесть"></textarea>
              </label>
              <label class="lead-quiz__consent">
                <input type="checkbox" name="consent" value="Да" required />
                <span>{privacyText}</span>
              </label>
            </div>
            <p class="lead-quiz__error" data-contact-error hidden>Проверьте телефон, населённый пункт и согласие.</p>
          </fieldset>

          <div class="lead-quiz__actions">
            <button type="button" data-quiz-back>Назад</button>
            <button type="button" data-quiz-next>Далее</button>
            <button type="submit" data-quiz-submit hidden>{submitText}</button>
          </div>
          <p class="lead-quiz__privacy">Расчёт по фотографиям предварительный. Точная смета — после получения необходимых параметров.</p>
        </form>
        <div class="lead-quiz__status" data-lead-status tabindex="-1" hidden></div>
        <div data-lead-success hidden>Спасибо! Данные получены. Мы изучим параметры и свяжемся выбранным способом.</div>
      </div>
    </div>
  </div>
</section>

<style>
  .lead-quiz { padding: var(--spacing-section) var(--space-4); background: var(--color-primary-dark); color: var(--color-white); }
  .lead-quiz__inner { width: min(100%, var(--container-width)); margin: 0 auto; display: grid; grid-template-columns: 1fr auto; gap: 36px; align-items: end; }
  .lead-quiz__copy { max-width: 820px; }
  .lead-quiz__badge { display: inline-flex; margin: 0 0 16px; padding: 8px 12px; border: 1px solid rgb(255 255 255 / 24%); border-radius: 999px; color: #ffd2ba; font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .lead-quiz h2 { margin: 0; font-family: var(--font-heading); font-size: var(--text-3xl); line-height: var(--leading-tight); }
  .lead-quiz__subline { max-width: 680px; color: rgb(255 255 255 / 72%); font-size: var(--text-lg); line-height: 1.65; }
  .lead-quiz__copy ul { display: flex; flex-wrap: wrap; gap: 10px; margin: 28px 0 0; padding: 0; list-style: none; }
  .lead-quiz__copy li { padding: 9px 12px; border-radius: 999px; background: rgb(255 255 255 / 8%); font-size: 14px; }
  .lead-quiz__trigger, .lead-quiz__actions button { min-height: 54px; padding: 0 24px; border: 0; border-radius: var(--radius-button); color: #fff; background: var(--color-accent); cursor: pointer; font-weight: 800; }
  .lead-quiz__modal { position: fixed; inset: 0; z-index: 100; display: none; place-items: center; padding: 18px; background: rgb(5 15 24 / 88%); backdrop-filter: blur(10px); }
  .lead-quiz__modal.is-open { display: grid; }
  .lead-quiz__dialog { position: relative; width: min(100%, 760px); max-height: 94vh; overflow: auto; padding: 30px; border-radius: var(--radius-card); color: var(--color-text); background: var(--color-surface); box-shadow: 0 30px 90px rgb(0 0 0 / 42%); scrollbar-width: none; }
  .lead-quiz__dialog::-webkit-scrollbar { display: none; }
  .lead-quiz__dialog h2 { font-size: var(--text-2xl); }
  .lead-quiz__close { position: absolute; top: 14px; right: 14px; width: 44px; height: 44px; border: 0; border-radius: 50%; color: var(--color-text); background: var(--color-background); cursor: pointer; font-size: 26px; }
  .lead-quiz__step-label { margin: 0 0 8px; color: var(--color-accent); font-size: 13px; font-weight: 800; text-transform: uppercase; }
  .lead-quiz__progress { height: 7px; margin: 24px 0 30px; overflow: hidden; border-radius: 999px; background: var(--color-border); }
  .lead-quiz__progress span { display: block; width: 16.66%; height: 100%; border-radius: inherit; background: var(--color-accent); transition: width .2s ease; }
  .lead-quiz__step { display: none; margin: 0; padding: 0; border: 0; }
  .lead-quiz__step.is-active { display: block; }
  .lead-quiz__step > legend { margin-bottom: 20px; font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 800; }
  .lead-quiz__options { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .lead-quiz__options label { display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: center; min-height: 58px; padding: 14px; border: 1px solid var(--color-border); border-radius: 14px; cursor: pointer; background: #fff; }
  .lead-quiz__options label:has(input:checked) { border-color: var(--color-accent); background: var(--color-accent-light); }
  .lead-quiz__fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .lead-quiz__fields > label { display: grid; gap: 7px; color: var(--color-text); font-size: 14px; font-weight: 700; }
  .lead-quiz input:not([type="radio"]):not([type="checkbox"]), .lead-quiz textarea { width: 100%; min-height: 50px; padding: 12px 14px; border: 1px solid var(--color-border); border-radius: 12px; color: var(--color-text); background: #fff; }
  .lead-quiz textarea { min-height: 108px; resize: vertical; }
  .lead-quiz__contact-method { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 12px; padding: 14px; border: 1px solid var(--color-border); border-radius: 14px; }
  .lead-quiz__contact-method legend { padding: 0 5px; font-weight: 800; }
  .lead-quiz__contact-method label { display: flex; gap: 6px; align-items: center; }
  .lead-quiz__consent { grid-column: 1 / -1; grid-template-columns: 22px 1fr !important; align-items: start; font-weight: 500 !important; line-height: 1.45; }
  .lead-quiz__dialpad { display: none; }
  .lead-quiz__error { color: #b42318; font-size: 14px; font-weight: 700; }
  .lead-quiz__actions { display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; }
  .lead-quiz__actions [data-quiz-back] { color: var(--color-text); background: var(--color-background); }
  .lead-quiz__privacy { margin: 14px 0 0; color: var(--color-text-muted); font-size: 12px; line-height: 1.5; }
  .lead-quiz__status, [data-lead-success] { margin-top: 18px; padding: 16px; border-radius: 12px; background: var(--color-accent-light); color: var(--color-text); }

  @media (max-width: 760px) {
    .lead-quiz__inner { grid-template-columns: 1fr; align-items: start; }
    .lead-quiz__trigger, .lead-quiz__actions button { width: 100%; }
    .lead-quiz__dialog { padding: 24px 16px; }
    .lead-quiz__options, .lead-quiz__fields { grid-template-columns: 1fr; }
    .lead-quiz__name-field, .lead-quiz__desktop-phone { display: none !important; }
    .lead-quiz__dialpad { display: grid; gap: 10px; padding: 14px; border: 1px solid var(--color-border); border-radius: 16px; }
    .lead-quiz__dialpad output { display: grid; min-height: 54px; place-items: center; border-radius: 12px; color: var(--color-primary-dark); background: var(--color-background); font-size: 24px; font-weight: 800; letter-spacing: .08em; }
    .lead-quiz__keys { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .lead-quiz__keys button { min-height: 52px; border: 1px solid var(--color-border); border-radius: 12px; color: var(--color-text); background: #fff; font-weight: 800; }
    .lead-quiz__contact-method, .lead-quiz__consent { grid-column: auto; }
  }
</style>

<script>
  const initLeadQuiz = () => {
    document.querySelectorAll<HTMLElement>("[data-lead-quiz]").forEach((root) => {
      if (root.dataset.quizReady === "true") return;
      root.dataset.quizReady = "true";
      const modal = root.querySelector<HTMLElement>("[data-quiz-modal]");
      const openButton = root.querySelector<HTMLButtonElement>("[data-quiz-open]");
      const closeButton = root.querySelector<HTMLButtonElement>("[data-quiz-close]");
      const form = root.querySelector<HTMLFormElement>("form");
      const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-quiz-step]"));
      const backButton = root.querySelector<HTMLButtonElement>("[data-quiz-back]");
      const nextButton = root.querySelector<HTMLButtonElement>("[data-quiz-next]");
      const submitButton = root.querySelector<HTMLButtonElement>("[data-quiz-submit]");
      const progress = root.querySelector<HTMLElement>("[data-quiz-progress]");
      const progressRoot = progress?.parentElement;
      const stepLabel = root.querySelector<HTMLElement>("[data-quiz-step-label]");
      const phoneValue = root.querySelector<HTMLInputElement>("[data-phone-value]");
      const phoneInput = root.querySelector<HTMLInputElement>("[data-phone-input]");
      const dialpad = root.querySelector<HTMLElement>("[data-dialpad]");
      const dialpadDisplay = root.querySelector<HTMLOutputElement>("[data-dialpad-display]");
      let currentStep = 0;
      let lastFocus: HTMLElement | null = null;
      let mobileDigits = "";

      const normalizePhone = (raw: string) => {
        const digits = raw.replace(/\D/g, "").replace(/^8/, "7");
        const body = digits.startsWith("7") ? digits.slice(1, 11) : digits.slice(0, 10);
        return body ? `+7${body}` : "";
      };

      const render = () => {
        steps.forEach((step, index) => step.classList.toggle("is-active", index === currentStep));
        if (backButton) backButton.hidden = currentStep === 0;
        if (nextButton) nextButton.hidden = currentStep === steps.length - 1;
        if (submitButton) submitButton.hidden = currentStep !== steps.length - 1;
        const ratio = ((currentStep + 1) / steps.length) * 100;
        if (progress) progress.style.width = `${ratio}%`;
        if (progressRoot) progressRoot.setAttribute("aria-valuenow", String(currentStep + 1));
        if (stepLabel) stepLabel.textContent = `Шаг ${currentStep + 1} из ${steps.length}`;
      };

      const close = () => {
        modal?.classList.remove("is-open");
        modal?.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        lastFocus?.focus();
      };

      openButton?.addEventListener("click", () => {
        lastFocus = document.activeElement as HTMLElement;
        modal?.classList.add("is-open");
        modal?.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        closeButton?.focus();
        render();
      });
      closeButton?.addEventListener("click", close);
      modal?.addEventListener("click", (event) => { if (event.target === modal) close(); });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape" && modal?.classList.contains("is-open")) close(); });

      backButton?.addEventListener("click", () => { currentStep = Math.max(0, currentStep - 1); render(); });
      nextButton?.addEventListener("click", () => {
        const step = steps[currentStep];
        const selected = step.querySelector<HTMLInputElement>("input:checked");
        const error = step.querySelector<HTMLElement>("[data-step-error]");
        if (!selected) { if (error) error.hidden = false; step.querySelector<HTMLInputElement>("input")?.focus(); return; }
        if (error) error.hidden = true;
        currentStep = Math.min(steps.length - 1, currentStep + 1);
        render();
      });

      phoneInput?.addEventListener("input", () => { if (phoneValue) phoneValue.value = normalizePhone(phoneInput.value); });
      dialpad?.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button");
        if (!button) return;
        if (button.dataset.digit && mobileDigits.length < 10) mobileDigits += button.dataset.digit;
        if (button.hasAttribute("data-backspace")) mobileDigits = mobileDigits.slice(0, -1);
        if (button.hasAttribute("data-clear")) mobileDigits = "";
        if (phoneValue) phoneValue.value = mobileDigits ? `+7${mobileDigits}` : "";
        if (dialpadDisplay) dialpadDisplay.value = `+7 ${mobileDigits}`;
      });

      form?.addEventListener("change", () => {
        const safeData: Record<string, string | string[]> = {};
        new FormData(form).forEach((value, key) => {
          const isPrivateField = key === "phone" || key === "name" || key === "comment" || key === "photos[]" || key === "consent";
          if (isPrivateField || value instanceof File) return;
          if (key.endsWith("[]")) safeData[key] = [...(safeData[key] as string[] || []), String(value)];
          else safeData[key] = String(value);
        });
        sessionStorage.setItem("lr-furnace-quiz", JSON.stringify(safeData));
      });

      form?.addEventListener("submit", (event) => {
        const location = form.querySelector<HTMLInputElement>('[name="location"]');
        const consent = form.querySelector<HTMLInputElement>('[name="consent"]');
        const contactError = root.querySelector<HTMLElement>("[data-contact-error]");
        if (!phoneValue?.value.match(/^\+7\d{10}$/) || !location?.value.trim() || !consent?.checked) {
          event.preventDefault();
          if (contactError) contactError.hidden = false;
          (!phoneValue?.value ? (phoneInput || dialpad) : !location?.value.trim() ? location : consent)?.focus();
          return;
        }
        if (contactError) contactError.hidden = true;
      });
      render();
    });
  };

  initLeadQuiz();
  document.addEventListener("astro:page-load", initLeadQuiz);
</script>
