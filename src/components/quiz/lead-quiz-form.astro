---
interface QuizStep {
  question: string;
  options: string[];
  name?: string;
  multiple?: boolean;
}

interface Props {
  instance: "inline" | "modal";
  quizId: string;
  steps: QuizStep[];
  submitText: string;
  privacyText: string;
  service?: string;
}

const {
  instance,
  quizId,
  steps,
  submitText,
  privacyText,
  service = "Установка металлической печи",
} = Astro.props;
const prefix = `${quizId}-${instance}`;
const stepNames = [
  "object_type",
  "house_type",
  "stove_status",
  "services[]",
  "chimney_route",
];
const totalSteps = steps.length + 1;
---

<div class="lead-quiz-form" data-quiz-view={instance} data-lead-root>
  <div class="lead-quiz-form__topline">
    <p data-quiz-step-label>Шаг 1 из {totalSteps}</p>
  </div>

  <div
    class="lead-quiz-form__progress"
    role="progressbar"
    aria-label="Прогресс расчёта"
    aria-valuemin="1"
    aria-valuemax={totalSteps}
    aria-valuenow="1"
  >
    <span data-quiz-progress style={`width: ${100 / totalSteps}%`}></span>
  </div>

  <form
    id={`${prefix}-form`}
    class="lead-quiz-form__form"
    data-quiz-form
    data-quiz-instance={instance}
    data-hop-lead-form
    novalidate
  >
    <input
      type="hidden"
      name="quiz_service"
      value={service}
    />
    <input type="hidden" name="phone" data-phone-value value="" />

    {
      steps.map((step, stepIndex) => (
        <fieldset
          class:list={[
            "lead-quiz-form__step",
            { "is-active": stepIndex === 0 },
          ]}
          data-quiz-step
        >
          <legend>{step.question}</legend>
          <div class="lead-quiz-form__options">
            {step.options.map((option, optionIndex) => {
              const optionId = `${prefix}-step-${stepIndex}-option-${optionIndex}`;
              const isMultiple = step.multiple ?? stepIndex === 3;
              return (
                <label class="lead-quiz-form__option" for={optionId}>
                  <input
                    id={optionId}
                    type={isMultiple ? "checkbox" : "radio"}
                    name={step.name ?? stepNames[stepIndex] ?? `step_${stepIndex + 1}`}
                    value={option}
                  />
                  <span>{option}</span>
                </label>
              );
            })}
          </div>
          <p class="lead-quiz-form__error" data-step-error hidden>
            Выберите подходящий вариант.
          </p>
        </fieldset>
      ))
    }

    <fieldset class="lead-quiz-form__step" data-quiz-step>
      <legend>Как с вами связаться?</legend>
      <div class="lead-quiz-form__contact-methods-grid">
        {
          [
            {
              name: "Звонок",
              color: "#2ecc71",
              icon: `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/></svg>`,
            },
            {
              name: "VK",
              color: "#0077ff",
              icon: `<svg viewBox="0 0 67 42" aria-hidden="true"> <path d="M35.9736 41.625C13.4075 41.625 0.536337 26 0 0H11.3037C11.675 19.0833 20.0081 27.1666 26.6087 28.8333V0H37.2527V16.4582C43.7708 15.7499 50.6181 8.25 52.9284 0H63.5723C61.7983 10.1667 54.3726 17.6666 49.0921 20.7499C54.3726 23.2499 62.8301 29.7916 66.0479 41.625H54.3314C51.8149 33.7083 45.5448 27.5833 37.2527 26.7499V41.625H35.9736Z" fill="currentColor"></path> </svg>`,
            },
            {
              name: "Telegram",
              color: "#26a5e4",
              icon: `<svg viewBox="0 0 24 20" aria-hidden="true"> <path d="M21.9539 0.176566C21.9539 0.176566 24.1741 -0.689148 23.989 1.4133C23.9274 2.27903 23.3724 5.30902 22.9406 8.58639L21.4605 18.2948C21.4605 18.2948 21.3372 19.717 20.2271 19.9644C19.117 20.2117 17.4519 19.0987 17.1435 18.8513C16.8968 18.6658 12.5182 15.8831 10.9763 14.5227C10.5446 14.1517 10.0513 13.4096 11.038 12.5439L17.5136 6.36028C18.2536 5.61823 18.9937 3.8868 15.9101 5.98925L7.27606 11.8638C7.27606 11.8638 6.28932 12.4821 4.4392 11.9256L0.430526 10.6888C0.430526 10.6888 -1.04959 9.76131 1.47894 8.83371C7.64612 5.92737 15.2317 2.9592 21.9539 0.176566Z" fill="currentColor"></path> </svg>`,
            },
            {
              name: "WhatsApp",
              color: "#25D366",
              icon: `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.662-2.062-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`,
            },
          ].map((method, index) => {
            const methodId = `${prefix}-contact-${index}`;
            return (
              <label class="lead-quiz-form__contact-btn" for={methodId}>
                <input
                  id={methodId}
                  type="radio"
                  name="contact_method"
                  value={method.name}
                />
                <span
                  class="lead-quiz-form__contact-icon"
                  style={`color: ${method.color}`}
                  set:html={method.icon}
                />
                <span class="lead-quiz-form__contact-name">{method.name}</span>
              </label>
            );
          })
        }
      </div>
      <p class="lead-quiz-form__error" data-step-error hidden>
        Выберите удобный способ связи.
      </p>
    </fieldset>

    <fieldset
      class="lead-quiz-form__step lead-quiz-form__step--technical"
      data-quiz-step
    >
      <div class="lead-quiz-form__calculating">
        <div class="lead-quiz-form__calc-visual">
          <div class="lead-quiz-form__calc-ring">
            <svg viewBox="0 0 100 100">
              <circle
                cx="50"
                cy="50"
                r="42"
                fill="none"
                stroke="#f0f3f5"
                stroke-width="6"></circle>
              <circle
                class="lead-quiz-form__calc-arc"
                cx="50"
                cy="50"
                r="42"
                fill="none"
                stroke="url(#calcGrad)"
                stroke-width="6"
                stroke-linecap="round"
                stroke-dasharray="264"
                stroke-dashoffset="264"></circle>
              <defs>
                <linearGradient id="calcGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#e76525"></stop>
                  <stop offset="100%" stop-color="#ff985c"></stop>
                </linearGradient>
              </defs>
            </svg>
            <span class="lead-quiz-form__calc-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path><polyline points="14 2 14 8 20 8"></polyline><line
                  x1="16"
                  y1="13"
                  x2="8"
                  y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
                ></line><polyline points="10 9 9 9 8 9"></polyline></svg
              >
            </span>
          </div>
        </div>
        <p>Подбираем оптимальное решение</p>
        <span class="lead-quiz-form__calc-dots"><i></i><i></i><i></i></span>
      </div>
    </fieldset>

    <fieldset
      class="lead-quiz-form__step lead-quiz-form__step--final"
      data-quiz-step
    >
      <div class="lead-quiz-form__final-header">
        <div class="lead-quiz-form__final-emoji" aria-hidden="true">📱</div>
        <legend>Куда отправить результат?</legend>
        <p>Оставьте номер — мы перезвоним<br />и обсудим детали</p>
      </div>
      <div class="lead-quiz-form__fields lead-quiz-form__fields--final">
        <label class="lead-quiz-form__desktop-phone" for={`${prefix}-phone`}>
          <input
            id={`${prefix}-phone`}
            type="tel"
            data-phone-input
            autocomplete="tel"
            inputmode="tel"
            placeholder="+7 (___) ___-__-__"
          />
        </label>

        <div class="lead-quiz-form__dialpad" data-dialpad>
          <output data-dialpad-display aria-live="polite">+7</output>
          <div class="lead-quiz-form__keys" aria-label="Цифровая клавиатура">
            {
              [1, 2, 3, 4, 5, 6, 7, 8, 9].map((digit) => (
                <button type="button" data-digit={digit}>
                  {digit}
                </button>
              ))
            }
            <button type="button" data-clear aria-label="Очистить номер"
              >C</button
            >
            <button type="button" data-digit="0">0</button>
            <button
              type="button"
              data-backspace
              aria-label="Удалить последнюю цифру">⌫</button
            >
          </div>
        </div>

        <label class="lead-quiz-form__consent" for={`${prefix}-consent`}>
          <input
            id={`${prefix}-consent`}
            type="checkbox"
            name="consent"
            value="Да"
            required
          />
          <span>{privacyText}</span>
        </label>
      </div>
      <p class="lead-quiz-form__error" data-contact-error hidden>
        Проверьте телефон и согласие.
      </p>
    </fieldset>

    <div class="lead-quiz-form__actions">
      <button type="button" data-quiz-back>Назад</button>
      <button type="button" data-quiz-next>Далее</button>
      <button type="submit" data-quiz-submit hidden>{submitText}</button>
    </div>
    <p class="lead-quiz-form__privacy">
      Расчёт по фотографиям предварительный. Точная смета — после получения
      необходимых параметров.
    </p>
  </form>

  <div class="lead-quiz-form__status" data-lead-status tabindex="-1" hidden>
  </div>
  <div class="lead-quiz-form__success" data-lead-success hidden>
    <div class="lead-quiz-form__success-particles" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i><i></i>
    </div>
    <div class="lead-quiz-form__success-icon">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <h3>Отлично, заявка принята!</h3>
    <p>Мы свяжемся с вами в ближайшее время выбранным способом связи</p>
  </div>
</div>

<style>
  .lead-quiz-form {
    min-width: 0;
    height: 480px;
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 3vw, 30px);
    border: 1px solid rgb(21 32 40 / 8%);
    border-radius: 20px;
    background: var(--color-surface, #ffffff);
    color: var(--color-text, #152028);
    box-shadow: 0 24px 70px rgb(3 17 28 / 24%);
    overflow: hidden;
  }

  .lead-quiz-form__form {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .lead-quiz-form__step.is-active {
    flex: 1;
  }

  .lead-quiz-form__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .lead-quiz-form__topline p {
    margin: 0;
    color: var(--color-accent, #e76525);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .lead-quiz-form__expand {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 0;
    border: 0;
    color: var(--color-text-muted, #60717d);
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 800;
  }

  .lead-quiz-form__expand span {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 9px;
    background: var(--color-background, #f6f4ef);
  }

  .lead-quiz-form__progress {
    position: relative;
    height: 8px;
    margin: 16px 0 26px;
    overflow: hidden;
    border-radius: 999px;
    background: #f0f3f5;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);
  }

  .lead-quiz-form__progress span {
    position: relative;
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #e76525, #ff985c);
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 10px rgba(231, 101, 37, 0.4);
  }

  .lead-quiz-form__progress span::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    background: linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.2) 25%,
      transparent 25%,
      transparent 50%,
      rgba(255, 255, 255, 0.2) 50%,
      rgba(255, 255, 255, 0.2) 75%,
      transparent 75%,
      transparent
    );
    background-size: 20px 20px;
    animation: progressStripe 2s linear infinite;
  }

  @keyframes progressStripe {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 20px 0;
    }
  }

  .lead-quiz-form__step {
    display: none;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .lead-quiz-form__step.is-active {
    display: block;
    animation: quizStepIn 0.35s ease-out;
  }

  @keyframes quizStepIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lead-quiz-form__step > legend {
    margin-bottom: 18px;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 800;
    line-height: 1.2;
  }

  .lead-quiz-form__options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .lead-quiz-form__option {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    min-height: 54px;
    padding: 12px 14px;
    border: 1px solid var(--color-border, #d6dee3);
    border-radius: 12px;
    background: #ffffff;
    cursor: pointer;
    transition:
      border-color 0.16s ease,
      background 0.16s ease,
      transform 0.16s ease;
  }

  .lead-quiz-form__option:hover {
    transform: translateY(-1px);
  }

  .lead-quiz-form__option:has(input:checked) {
    border-color: var(--color-accent, #e76525);
    background: var(--color-accent-light, #ffefe5);
  }

  .lead-quiz-form input[type="radio"],
  .lead-quiz-form input[type="checkbox"] {
    accent-color: var(--color-accent, #e76525);
  }

  .lead-quiz-form__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
  }

  .lead-quiz-form__fields > label {
    display: grid;
    gap: 7px;
    min-width: 0;
    font-size: 14px;
    font-weight: 700;
  }

  .lead-quiz-form input:not([type="radio"]):not([type="checkbox"]),
  .lead-quiz-form textarea {
    width: 100%;
    min-height: 50px;
    padding: 12px 14px;
    border: 1px solid var(--color-border, #d6dee3);
    border-radius: 12px;
    color: var(--color-text, #152028);
    background: #ffffff;
    font: inherit;
  }

  .lead-quiz-form textarea {
    min-height: 100px;
    resize: vertical;
  }

  .lead-quiz-form input.lead-quiz-form__file-input {
    position: absolute;
    width: 1px;
    height: 1px;
    min-height: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    opacity: 0;
  }

  .lead-quiz-form__file-picker {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    min-height: 52px;
    padding: 7px;
    border: 1px solid var(--color-border, #d6dee3);
    border-radius: 12px;
    background: #ffffff;
    cursor: pointer;
  }

  .lead-quiz-form__file-picker strong {
    display: grid;
    min-height: 38px;
    padding: 0 12px;
    place-items: center;
    border-radius: 9px;
    color: #ffffff;
    background: var(--color-primary-dark, #0b1f33);
    font-size: 12px;
  }

  .lead-quiz-form__file-field:focus-within .lead-quiz-form__file-picker {
    outline: 3px solid var(--color-accent, #e76525);
    outline-offset: 3px;
  }

  .lead-quiz-form__file-picker small[data-file-summary] {
    overflow-wrap: anywhere;
    color: var(--color-text-muted, #60717d);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
  }

  .lead-quiz-form__contact-method {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--color-border, #d6dee3);
    border-radius: 14px;
  }

  .lead-quiz-form__contact-method legend {
    padding: 0 5px;
    font-weight: 800;
  }
  .lead-quiz-form__contact-method label {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .lead-quiz-form__consent {
    grid-column: 1 / -1;
    grid-template-columns: 22px minmax(0, 1fr) !important;
    align-items: start;
    font-weight: 500 !important;
    line-height: 1.45;
  }

  .lead-quiz-form__dialpad {
    display: none;
  }

  .lead-quiz-form__error {
    margin: 12px 0 0;
    color: #b42318;
    font-size: 13px;
    font-weight: 700;
  }

  .lead-quiz-form__actions {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
  }

  .lead-quiz-form__actions [data-quiz-next],
  .lead-quiz-form__actions [data-quiz-submit] {
    margin-left: auto;
  }

  .lead-quiz-form__actions button {
    min-height: 50px;
    padding: 0 22px;
    border: 0;
    border-radius: var(--radius-button, 12px);
    color: #ffffff;
    background: var(--color-accent, #e76525);
    cursor: pointer;
    font: inherit;
    font-weight: 800;
  }

  .lead-quiz-form__actions [data-quiz-back] {
    color: var(--color-text, #152028);
    background: var(--color-background, #f6f4ef);
  }

  .lead-quiz-form__privacy {
    margin: 13px 0 0;
    color: var(--color-text-muted, #60717d);
    font-size: 11px;
    line-height: 1.5;
  }

  /* Final Step */
  .lead-quiz-form__step--final {
    text-align: center;
    padding-top: 4px;
  }

  .lead-quiz-form__final-emoji {
    font-size: 36px;
    line-height: 1;
    margin-bottom: 8px;
    animation: quizStepIn 0.5s ease-out;
  }

  .lead-quiz-form__final-header legend {
    font-size: 26px;
    margin-bottom: 8px;
  }

  .lead-quiz-form__final-header p {
    color: var(--color-text-muted, #60717d);
    font-size: 15px;
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .lead-quiz-form__fields--final {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 360px;
    margin: 0 auto;
  }

  .lead-quiz-form__fields--final input[type="tel"] {
    font-size: 24px;
    font-weight: 800;
    text-align: center;
    letter-spacing: 0.05em;
    padding: 16px;
    height: 64px;
    border-radius: 16px;
    border: 2px solid var(--color-border, #d6dee3);
    transition: all 0.3s ease;
    background: var(--color-background, #f6f4ef);
  }

  .lead-quiz-form__fields--final input[type="tel"]:focus {
    border-color: var(--color-accent, #e76525);
