<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content">
    <Hero {...hero} />
    <SocialLinks {...social} variant="qr-strip" />
    <LeadQuiz {...quiz} />
    <FeatureGrid {...repairDirections} />
    <MaterialsGrid {...stoveTypes} variant="equipment-lineup" />
    <EquipmentProcess {...solutionFormats} />
    <BeforeAfterCases {...cases} />
    <FeatureGrid {...workStages} />
    <CostFactors {...cost} />
    <Guarantee {...guarantee} />
    <Faq {...faq} />
    <ContactForm {...contact} />
  </main>
</BaseLayout>
