---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content">
    <Hero {...hero} />
    <SocialLinks {...social} variant="qr-strip" />
    <LeadQuiz {...quiz} />
    <FeatureGrid {...repairDirections} />
    <MaterialsGrid {...stoveTypes} variant="equipment-lineup" />
    <CaseSlider {...cases} />
    <ServiceCrosslink
      index="01"
      eyebrow="Установка печей"
      headline="Проще заменить печь на новую?"
      text="Подготовим место, установим металлическую печь и соберём дымоход."
      href="/"
      linkLabel="Посмотреть установку"
    />
    <FeatureGrid {...workStages} />
    <CostFactors {...cost} />
    <Faq {...faq} />
    <ContactForm {...contact} />
  </main>
</BaseLayout>
