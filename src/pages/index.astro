        <ServiceCrosslink
            index="02"
            eyebrow="Ремонт и реставрация"
            headline="Печь уже установлена и требует восстановления?"
            text="Восстановим кладку, топочную часть, облицовку или подключение к дымоходу."
            href="/remont-i-restavratsiya-pechey/"
            linkLabel="Посмотреть ремонт печей"
        />
        <!-- <Block11 {...blockProps[7]} variant="qr-strip" showQr={false} /> -->
        <Block14 {...blockProps[8]} />
